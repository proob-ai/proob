{
  "description": "proob: a one-line status at session start and fail-fast schema feedback on writes under proob/. Both fail open: a missing binary never blocks normal work (R12).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
