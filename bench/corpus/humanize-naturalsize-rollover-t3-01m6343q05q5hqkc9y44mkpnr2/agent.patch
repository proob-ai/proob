+@given(st.integers(min_value=-(10**101), max_value=10**101))
+def test_intword_never_shows_thousand_of_a_unit(value: int) -> None:
+    text = humanize.intword(value)
+    head = text.split(" ")[0].lstrip("-")
+    if " " in text:
+        assert float(head) < 1000, (value, text)
+
+
