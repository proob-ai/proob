+def test_metric_mantissa_below_1000(value: float) -> None:
+    text = humanize.metric(value)
+    if "x 10" in text:
+        return  # scientific fallback carries no SI prefix
+    mantissa = float(text.split(" ")[0])
+    assert abs(mantissa) < 1000, (value, text)
