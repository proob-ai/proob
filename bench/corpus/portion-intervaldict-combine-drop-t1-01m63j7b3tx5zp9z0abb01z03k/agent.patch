+# proob:01M63J7B5WYQ30R9D47JM92RS8
+@given(st.lists(atomics(), max_size=4), st.data())
+def test_same_points_compare_equal_and_hash_equal(xs, data):
+    i = P.Interval(*xs)
+    same = [
+        P.Interval(*data.draw(st.permutations(xs))),
+        functools.reduce(operator.or_, xs, P.empty()),
+        ~~i,
+        i - P.empty(),
+        data.draw(intervals),
+    ]
+    for j in same:
+        if points_of(i) == points_of(j):
+            assert i == j and hash(i) == hash(j), (xs, i, j)
