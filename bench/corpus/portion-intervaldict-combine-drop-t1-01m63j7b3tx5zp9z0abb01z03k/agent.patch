+# proob:01M63J7B3TX5ZP9Z0ABB01Z03K
+@given(dicts, dicts)
+def test_combine_keeps_every_covered_point(d1, d2):
+    combined = d1.combine(d2, lambda x, y: (x, y))
+    for p in POINTS:
+        v1, v2 = lookup(d1, p), lookup(d2, p)
+        expected = (v1, v2) if v1 and v2 else v1 or v2
+        assert lookup(combined, p) == expected, (d1, d2, p, combined)
+
+
+# proob:01M63J7B4TWJGJJ8EATM14MCZM
+@given(dicts, pairs, intervals, dicts)
+def test_keys_never_overlap_and_values_are_distinct(d, more, removed, other):
+    d.update(more)
+    del d[removed]
+    for result in (d, d.combine(other, lambda x, y: x + y)):
+        items = list(result.items())
+        for n, (k1, v1) in enumerate(items):
+            for k2, v2 in items[n + 1 :]:
+                assert (k1 & k2).empty, (result, k1, k2)
+                assert v1 != v2, (result, k1, k2, v1)
+
+
+# proob:01M63J7B83DBD65W70RQT47QWB
+@given(dicts, pairs)
+def test_later_values_win_on_update(d, updates):
+    before = {p: lookup(d, p) for p in POINTS}
+    d.update(updates)
+    for p in POINTS:
+        expected = next((v for i, v in reversed(updates) if p in i), before[p])
+        assert lookup(d, p) == expected, (updates, p, d)
