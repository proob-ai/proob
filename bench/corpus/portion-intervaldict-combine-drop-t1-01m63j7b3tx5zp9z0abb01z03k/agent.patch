@@ -0,0 +1,35 @@
+from fractions import Fraction
+
+from hypothesis import strategies as st
+
+import portion as P
+
+# Integer bounds in [-R, R]; membership between two integers is constant, so
+# every integer and every half-integer in [-R-1, R+1] decides set equality.
+R = 10
+POINTS = [Fraction(k, 2) for k in range(-2 * R - 2, 2 * R + 3)]
+
+_bound = st.sampled_from([P.CLOSED, P.OPEN])
+_lower = st.one_of(st.integers(-R, R), st.just(-P.inf))
+_upper = st.one_of(st.integers(-R, R), st.just(P.inf))
+
+
+@st.composite
+def atomics(draw):
+    lo, hi = sorted([draw(_lower), draw(_upper)])
+    return P.Interval.from_atomic(draw(_bound), lo, hi, draw(_bound))
+
+
+intervals = st.lists(atomics(), max_size=4).map(lambda xs: P.Interval(*xs))
+values = st.sampled_from("abcd")
+pairs = st.lists(st.tuples(intervals, values), max_size=6)
+dicts = pairs.map(P.IntervalDict)
+
+
+def points_of(i):
+    return frozenset(p for p in POINTS if p in i)
+
+
+def lookup(d, p):
+    """The value d gives point p, or None when p is outside its domain."""
+    return d[p] if p in d.domain() else None
