+ordered_bidict_t = sampled_from([b for b in bidict_types if issubclass(b, OrderedBidictBase)])
+forward_ops = one_of(
+    tuples(just('put'), keys, vals, on_dup),
+    tuples(just('forceput'), keys, vals),
+    tuples(just('pop'), keys),
+    tuples(just('popitem'), booleans()),
+    tuples(just('move_to_end'), keys, booleans()),
+)
+
