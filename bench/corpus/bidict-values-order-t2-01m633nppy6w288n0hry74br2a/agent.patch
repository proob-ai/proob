+# proob:01M633NPSM886QNZH9PMD1D617
+@given(bidict_t=ordered_bidict_t, items=items, ops=lists(forward_ops, max_size=12))
+def test_ordered_bidicts_keep_insertion_order(bidict_t: BT[int, int], items: Items, ops: list[t.Any]) -> None:
+    oracle: Oracle[int, int] = Oracle({}, ordered=True)
+    try:
+        oracle.putall(items, bidict_t.on_dup)
+    except DuplicationError:
+        oracle = Oracle(dedup(items), ordered=True)
+    bi = build(bidict_t, items)
+    for op in [None, *ops]:
+        if op is not None and isinstance(bi, OrderedBidict):
+            name, *args = op
+            if name == 'forceput':
+                name, args = 'put', [*args, OnDup(OnDupAction.DROP_OLD, OnDupAction.DROP_OLD)]
+            outcomes = []
+            for obj in (bi, oracle):
+                try:
+                    getattr(obj, name)(*args)
+                    outcomes.append(None)
+                except (KeyError, StopIteration):  # the model's popitem(last=False) on empty raises StopIteration
+                    outcomes.append(KeyError)
+                except DuplicationError as exc:
+                    outcomes.append(type(exc))
+            assert outcomes[0] == outcomes[1], f'{op}: bidict raised {outcomes[0]}, model raised {outcomes[1]}'
+        expect = list(oracle.data.items())
+        assert list(bi.items()) == expect, f'after {op}: items {list(bi.items())}, expected {expect}'
+        assert list(bi) == [k for (k, _) in expect], f'after {op}: keys {list(bi)}'
+        expect_repr = f'{bidict_t.__name__}({oracle.data!r})' if expect else f'{bidict_t.__name__}()'
+        assert repr(bi) == expect_repr, f'after {op}: {bi!r}, expected {expect_repr}'
