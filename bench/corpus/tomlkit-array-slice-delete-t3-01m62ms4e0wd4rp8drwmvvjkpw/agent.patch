+# Single-character edits of valid documents. Escapes, inline tables and the
+# backslash are left out so no edit yields a construct that TOML 1.1 (tomlkit)
+# accepts and TOML 1.0 (tomllib, the oracle) rejects.
+_edit_chars = st.sampled_from(list("=[]\"',.#\n\r\t -_:0aZ{}"))
+
+
+@st.composite
+def _edited_documents(draw: st.DrawFn) -> str:
+    text = draw(toml_documents(escapes=False, inline_tables=False))
+    at = draw(st.integers(0, len(text)))
+    kind = draw(st.sampled_from(["insert", "delete", "replace"]))
+    char = draw(_edit_chars)
+    if kind == "insert":
+        return text[:at] + char + text[at:]
+    rest = text[at + 1 :]
+    return text[:at] + (char if kind == "replace" else "") + rest
+
+
