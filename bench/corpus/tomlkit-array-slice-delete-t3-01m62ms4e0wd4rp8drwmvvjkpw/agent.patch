+
+def same_value(a: object, b: object) -> bool:
+    """Deep equality of unwrapped values that treats nan as equal to nan."""
+    if isinstance(a, float) and isinstance(b, float):
+        return (math.isnan(a) and math.isnan(b)) or a == b
+    if isinstance(a, dict) and isinstance(b, dict):
+        return a.keys() == b.keys() and all(same_value(a[k], b[k]) for k in a)
+    if isinstance(a, list) and isinstance(b, list):
+        return len(a) == len(b) and all(map(same_value, a, b))
+    return type(a) is type(b) and a == b
+
+
+# Generators of valid TOML text for property-based tests. Every form below is
+# valid in both TOML 1.0 and 1.1; ``escapes`` and ``inline_tables`` can be
+# turned off so a single-character edit cannot produce a 1.1-only construct.
+_ws = st.sampled_from(["", " ", "  ", "\t"])
+_comment = st.text(
+    st.characters(min_codepoint=0x20, max_codepoint=0x7E), max_size=8
+).map(lambda c: "#" + c)
+_safe_char = st.characters(
+    min_codepoint=0x20, max_codepoint=0x7E, exclude_characters="\"\\'"
+)
+_integers = st.one_of(
+    st.integers(-(10**12), 10**12).map(str),
+    st.sampled_from(["+1", "1_000", "0xDEAD_beef", "0o755", "0b1101", "-0", "+0"]),
+)
+_floats = st.sampled_from(
+    ["1.5", "-0.0", "+1e3", "6.626e-34", "1_000.5", "inf", "-inf", "+nan", "3.14E+2"]
+)
+_datetimes = st.sampled_from(
+    [
+        "1979-05-27T07:32:00Z",
+        "1979-05-27 07:32:00.999999-07:00",
+        "1979-05-27T00:32:00.5+09:00",
+        "1979-05-27T07:32:00",
+        "1979-05-27",
+        "07:32:00",
+        "00:32:00.999",
+    ]
+)
+
+
+def _strings(escapes: bool) -> st.SearchStrategy[str]:
+    pieces = st.one_of(_safe_char, st.sampled_from(["\\n", "\\t", '\\"', "\\\\", "\\u00e9"]))
+    basic = st.lists(pieces if escapes else _safe_char, max_size=6).map(
+        lambda p: '"' + "".join(p) + '"'
+    )
+    literal = st.text(_safe_char, max_size=6).map(lambda t: "'" + t + "'")
+    multi = st.lists(st.text(_safe_char, max_size=5), max_size=3).map(
+        lambda lines: '"""' + "\n".join(lines) + '"""'
+    )
+    return st.one_of(basic, literal, multi)
+
+
+def _scalars(escapes: bool) -> st.SearchStrategy[str]:
+    return st.one_of(
+        _integers, _floats, st.sampled_from(["true", "false"]), _strings(escapes), _datetimes
+    )
+
+
+@st.composite
+def toml_arrays(draw: st.DrawFn, elements: st.SearchStrategy[str]) -> str:
+    """An array literal in one of the layouts people write by hand."""
+    values = draw(st.lists(elements, max_size=5))
+    layout = draw(st.sampled_from(["inline", "multiline", "comma_first"]))
+    if layout == "inline" or not values:
+        sep = draw(_ws) + "," + draw(_ws)
+        trailing = draw(st.sampled_from(["", ","])) if values else ""
+        return "[" + draw(_ws) + sep.join(values) + trailing + draw(_ws) + "]"
+    if layout == "multiline":
+        lines = [
+            "    " + v + "," + draw(st.one_of(st.just(""), _comment.map(lambda c: " " + c)))
+            for v in values
+        ]
+        return "[\n" + "\n".join(lines) + "\n]"
+    return "[ " + values[0] + "".join("\n  , " + v for v in values[1:]) + "\n]"
+
+
+def _values(escapes: bool, inline_tables: bool) -> st.SearchStrategy[str]:
+    scalar = _scalars(escapes)
+    array = toml_arrays(st.one_of(scalar, toml_arrays(scalar)))
+    if not inline_tables:
+        return st.one_of(scalar, array)
+    inline = st.lists(st.one_of(scalar, array), max_size=3).map(
+        lambda vs: "{"
+        + ", ".join(f"i{n} = {v}" for n, v in enumerate(vs))
+        + "}"
+    )
+    return st.one_of(scalar, array, inline)
+
+
+@st.composite
+def _body(draw: st.DrawFn, prefix: str, values: st.SearchStrategy[str]) -> list[str]:
+    lines = []
+    for n in range(draw(st.integers(0, 4))):
+        key = draw(st.sampled_from([f"{prefix}{n}", f'"{prefix} {n}"', f"{prefix}{n}.sub"]))
+        tail = draw(st.one_of(st.just(""), _comment.map(lambda c: " " + c)))
+        lines.append(
+            draw(_ws) + key + draw(_ws) + "=" + draw(_ws) + draw(values) + tail
+        )
+        lines.extend(draw(st.lists(st.one_of(_ws, _comment), max_size=1)))
+    return lines
+
+
+@st.composite
+def toml_documents(
+    draw: st.DrawFn, escapes: bool = True, inline_tables: bool = True
+) -> str:
+    """A valid TOML document: root keys, then tables and arrays of tables."""
+    values = _values(escapes, inline_tables)
+    lines = draw(_body("k", values))
+    for n in range(draw(st.integers(0, 3))):
+        kind = draw(st.sampled_from(["table", "subtable", "aot"]))
+        if kind == "aot":
+            for _ in range(draw(st.integers(1, 2))):
+                lines.append(f"[[a{n}]]")
+                lines.extend(draw(_body("v", values)))
+            continue
+        name = f"t{n}" if kind == "table" else f"t{n}.s"
+        lines.append("[" + draw(_ws) + name + draw(_ws) + "]")
+        lines.extend(draw(_body("v", values)))
+    newline = draw(st.sampled_from(["\n", "\r\n"]))
+    text = newline.join(lines)
+    return text + draw(st.sampled_from(["", newline])) if text else text
