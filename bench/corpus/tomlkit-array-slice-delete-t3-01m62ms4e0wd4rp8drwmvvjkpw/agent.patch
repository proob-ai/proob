+@given(st.one_of(_number_like.map(lambda v: f"v = {v}\n"), _edited_documents()))
+def test_invalid_toml_is_rejected_and_never_read_as_another_value(content: str) -> None:
+    try:
+        reference = tomllib.loads(content)
+    except Exception:
+        reference = None
+
+    if reference is None:
+        with pytest.raises(TOMLKitError):
+            parse(content)
+        return
+    try:
