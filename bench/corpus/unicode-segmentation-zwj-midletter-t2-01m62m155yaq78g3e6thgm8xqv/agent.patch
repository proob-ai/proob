+proptest::proptest! {
+    // proob:01M62M155YAQ78G3E6THGM8XQV
+    #[test]
+    fn proptest_midletter_zwj_emoji_breaks_from_letters(
+        letters in proptest::collection::vec(
+            proptest::sample::select(&['a', 'Z', 'é', 'λ', 'ж', 'ß'][..]), 1..5),
+        mid in proptest::sample::select(&[':', '.', '\'', '·', '\u{2019}', '\u{fe55}'][..]),
+        joiners in 1usize..3,
+        emoji in proptest::sample::select(&['\u{1f600}', '\u{1f468}', '\u{2764}', '\u{1f44d}'][..]),
+        tail in segmentation_text(),
+    ) {
+        let head: String = letters.into_iter().collect();
+        let s = format!("{head}{mid}{}{emoji}{tail}", "\u{200d}".repeat(joiners));
+        let (fwd, rev) = word_starts(&s);
+        proptest::prop_assert!(
+            fwd.contains(&head.len()),
+            "forward segments of {:?} have no break before {:?} at {}: {:?}",
+            s, mid, head.len(), s.split_word_bounds().collect::<Vec<_>>()
+        );
+        proptest::prop_assert!(
+            rev.contains(&head.len()),
+            "reverse segments of {:?} have no break before {:?} at {}: {:?}",
+            s, mid, head.len(), s.split_word_bounds().rev().collect::<Vec<_>>()
+        );
+    }
+
+    // proob:01M62M156HSZNFPFSRHS3PM59C
+    #[test]
+    fn proptest_forward_reverse_word_bounds_agree(s in segmentation_text()) {
+        let fwd: Vec<(usize, &str)> = s.split_word_bound_indices().collect();
+        let mut rev: Vec<(usize, &str)> = s.split_word_bound_indices().rev().collect();
+        rev.reverse();
+        proptest::prop_assert_eq!(fwd, rev, "word bounds of {:?}", s);
+    }
+
+    // proob:01M62M1572CFZDHSQ4YD5ZZWF7
+    #[test]
+    fn proptest_grapheme_cursor_chunked_matches_whole(
+        s in segmentation_text(),
+        picks in proptest::collection::vec(proptest::prelude::any::<proptest::sample::Index>(), 0..8),
+        is_extended in proptest::prelude::any::<bool>(),
+    ) {
+        let offsets: Vec<usize> = s.char_indices().map(|(i, _)| i).collect();
+        let mut cuts: Vec<usize> = std::iter::once(0)
+            .chain(picks.iter().filter(|_| !offsets.is_empty()).map(|p| *p.get(&offsets)))
+            .collect();
+        cuts.sort_unstable();
+        cuts.dedup();
+        let whole: Vec<usize> = s.grapheme_indices(is_extended).map(|(i, _)| i).collect();
+        for &offset in offsets.iter().skip(1) {
+            let got = chunked_is_boundary(&s, &cuts, offset, is_extended);
+            proptest::prop_assert_eq!(
+                got, whole.contains(&offset),
+                "{:?} cuts={:?} offset={} extended={}", s, cuts, offset, is_extended
+            );
+        }
+    }
+
+    // proob:01M62M157MDDM134JDWEPNPXVC
+    #[test]
+    fn proptest_segments_rejoin_to_original(s in segmentation_text()) {
+        let rejoin_rev = |mut v: Vec<&str>| { v.reverse(); v.concat() };
+        let joined: Vec<(&str, String)> = vec![
+            ("graphemes(true)", s.graphemes(true).collect()),
+            ("graphemes(false)", s.graphemes(false).collect()),
+            ("graphemes(true).rev", rejoin_rev(s.graphemes(true).rev().collect())),
+            ("graphemes(false).rev", rejoin_rev(s.graphemes(false).rev().collect())),
+            ("split_word_bounds", s.split_word_bounds().collect()),
+            ("split_word_bounds.rev", rejoin_rev(s.split_word_bounds().rev().collect())),
+            ("split_sentence_bounds", s.split_sentence_bounds().collect()),
+            ("split_sentence_bound_indices",
+                s.split_sentence_bound_indices().map(|(_, p)| p).collect()),
+        ];
+        for (name, j) in joined {
+            proptest::prop_assert_eq!(&j, &s, "{} of {:?}", name, s);
+        }
+    }
