+    // proob:01M62M1585SRHRE54EC41QRJTZ
+    #[test]
+    fn proptest_splitters_never_panic(s in segmentation_text()) {
+        use unicode_segmentation::GraphemeCursor;
+        for ext in [true, false] {
+            let _ = s.graphemes(ext).count() + s.graphemes(ext).rev().count();
+            let _ = s.grapheme_indices(ext).count() + s.grapheme_indices(ext).rev().count();
+            let mut c = GraphemeCursor::new(0, s.len(), ext);
+            while let Ok(Some(_)) = c.next_boundary(&s, 0) {}
+            let mut c = GraphemeCursor::new(s.len(), s.len(), ext);
+            while let Ok(Some(_)) = c.prev_boundary(&s, 0) {}
+        }
+        let _ = s.unicode_words().count() + s.unicode_words().rev().count();
+        let _ = s.unicode_word_indices().count() + s.unicode_word_indices().rev().count();
+        let _ = s.split_word_bounds().count() + s.split_word_bounds().rev().count();
+        let _ = s.split_word_bound_indices().count() + s.split_word_bound_indices().rev().count();
+        let _ = s.unicode_sentences().count() + s.split_sentence_bounds().count();
+        let _ = s.split_sentence_bound_indices().count();
+    }
