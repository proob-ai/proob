+/// Characters that drive the UAX #29 rules (letters, digits, mid-word and
+/// mid-number punctuation, ZWJ, Extend, Format, emoji, regional indicators,
+/// Prepend, Indic linkers and consonants, Hebrew, Katakana, CR/LF, sentence
+/// terminators), mixed with any other `char` so the whole domain is reachable.
+fn segmentation_char() -> impl proptest::strategy::Strategy<Value = char> {
+    use proptest::prelude::*;
+    const POOL: &[char] = &[
+        'a', 'Z', 'é', 'λ', 'ж', '0', '7', ':', '.', ',', ';', '\'', '"', '·', '\u{2019}', '_',
+        ' ', '\t', '\r', '\n', '!', '?', '\u{85}', '\u{200d}', '\u{200b}', '\u{ad}', '\u{300}',
+        '\u{301}', '\u{fe0f}', '\u{1f600}', '\u{1f468}', '\u{1f3fe}', '\u{2764}', '\u{1f1e6}',
+        '\u{1f1fa}', '\u{600}', '\u{6dd}', '\u{94d}', '\u{93c}', '\u{915}', '\u{5d0}', '\u{30a2}',
+        '\u{3042}', '\u{4e00}', '\u{1100}', '\u{1161}', '\u{11a8}', '\u{ac00}', '\u{e0001}',
+    ];
+    prop_oneof![3 => proptest::sample::select(POOL), 1 => any::<char>()]
+}
+
+fn segmentation_text() -> impl proptest::strategy::Strategy<Value = String> {
+    use proptest::prelude::*;
+    proptest::collection::vec(segmentation_char(), 0..40).prop_map(|v| v.into_iter().collect())
+}
+
+/// Byte offsets where the forward and reverse word-bound iterators start a segment.
+fn word_starts(s: &str) -> (Vec<usize>, Vec<usize>) {
+    let fwd = s.split_word_bound_indices().map(|(i, _)| i).collect();
+    let mut rev: Vec<usize> = s.split_word_bound_indices().rev().map(|(i, _)| i).collect();
+    rev.reverse();
+    (fwd, rev)
+}
+
+/// Asks `GraphemeCursor::is_boundary` at `offset`, handing it only the chunk of
+/// `s` (cut at `cuts`) that contains the offset, plus earlier chunks on request.
+fn chunked_is_boundary(s: &str, cuts: &[usize], offset: usize, is_extended: bool) -> bool {
+    use unicode_segmentation::{GraphemeCursor, GraphemeIncomplete};
+    let chunk_at = |pos: usize| {
+        let start = *cuts.iter().filter(|&&c| c <= pos).max().unwrap();
+        let end = *cuts.iter().filter(|&&c| c > pos).min().unwrap_or(&s.len());
+        (start, end)
+    };
+    let ending_at = |n: usize| *cuts.iter().filter(|&&c| c < n).max().unwrap();
+    let (start, end) = chunk_at(offset);
+    let mut cursor = GraphemeCursor::new(offset, s.len(), is_extended);
+    loop {
+        match cursor.is_boundary(&s[start..end], start) {
+            Ok(b) => return b,
+            Err(GraphemeIncomplete::PreContext(n)) => {
+                let from = ending_at(n);
+                cursor.provide_context(&s[from..n], from);
+            }
+            Err(e) => panic!("{s:?} cuts={cuts:?} offset={offset}: unexpected {e:?}"),
+        }
+    }
+}
