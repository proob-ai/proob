diff --git a/crates/toml_edit/tests/testsuite/key.rs b/crates/toml_edit/tests/testsuite/key.rs
new file mode 100644
index 0000000..43709fe
--- /dev/null
+++ b/crates/toml_edit/tests/testsuite/key.rs
@@ -0,0 +1,50 @@
+use std::collections::hash_map::DefaultHasher;
+use std::hash::Hash;
+use std::hash::Hasher;
+
+use proptest::prelude::*;
+use toml_edit::Key;
+use toml_writer::ToTomlKey;
+use toml_writer::TomlKeyBuilder;
+
+fn hash_of(key: &Key) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    key.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// The same decoded key in every quoting the writer offers, parsed back
+fn spellings(decoded: &str) -> Vec<Key> {
+    let builder = TomlKeyBuilder::new(decoded);
+    let mut keys = vec![Key::new(decoded)];
+    let written = [
+        Some(builder.as_default()),
+        builder.as_unquoted(),
+        builder.as_literal(),
+        builder.as_basic_pretty(),
+        Some(builder.as_basic()),
+    ];
+    for encoded in written.into_iter().flatten().map(|k| k.to_toml_key()) {
+        let parsed = encoded.parse::<Key>();
+        keys.push(parsed.unwrap_or_else(|err| panic!("{encoded:?} did not parse: {err}")));
+    }
+    keys
+}
+
+proptest! {
+    // proob:01M63H6WR6CFPS0PA4WG9XHRZV
+    #[test]
+    fn key_equality_hashing_and_ordering_agree(a in any::<String>(), b in prop_oneof![any::<String>(), "[a-c]{0,2}"]) {
+        let left = spellings(&a);
+        let right = spellings(&b);
+        for (x, y) in left.iter().flat_map(|x| left.iter().chain(&right).map(move |y| (x, y))) {
+            let eq = x == y;
+            prop_assert_eq!(eq, x.cmp(y) == std::cmp::Ordering::Equal, "eq vs cmp for {:?} and {:?}", x, y);
+            prop_assert_eq!(Some(x.cmp(y)), x.partial_cmp(y), "cmp vs partial_cmp for {:?} and {:?}", x, y);
+            prop_assert_eq!(eq, x.get() == y.get(), "eq vs decoded text for {:?} and {:?}", x, y);
+            if eq {
+                prop_assert_eq!(hash_of(x), hash_of(y), "hash of equal keys {:?} and {:?}", x, y);
+            }
+        }
+    }
+}
