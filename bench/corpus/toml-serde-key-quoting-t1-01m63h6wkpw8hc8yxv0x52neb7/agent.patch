diff --git a/crates/toml_writer/tests/string.rs b/crates/toml_writer/tests/string.rs
index 2e68f01..2dc6b1a 100644
--- a/crates/toml_writer/tests/string.rs
+++ b/crates/toml_writer/tests/string.rs
@@ -703,3 +703,56 @@ proptest! {
         assert_eq!(value.as_str().unwrap(), decoded);
     }
 }
+
+fn parse_single_pair(toml: &str) -> (String, toml_old::Value) {
+    let value = match toml.parse::<toml_old::Value>() {
+        Ok(value) => value,
+        Err(err) => panic!("could not parse {toml:?}: {err}"),
+    };
+    let table = value.as_table().unwrap();
+    assert_eq!(table.len(), 1, "{toml:?} parsed to {table:?}");
+    let (key, value) = table.iter().next().unwrap();
+    (key.clone(), value.clone())
+}
+
+proptest! {
+    // proob:01M63H6WMTSNJ6D5YVE7DJQ4Z7
+    #[test]
+    fn every_written_key_parses_back_as_one_key(decoded in any::<String>()) {
+        let key = TomlKeyBuilder::new(&decoded);
+        let written = [
+            Some(key.as_default()),
+            key.as_unquoted(),
+            key.as_literal(),
+            key.as_basic_pretty(),
+            Some(key.as_basic()),
+        ];
+        for encoded in written.into_iter().flatten().map(|k| k.to_toml_key()) {
+            let toml = format!("{encoded} = 1");
+            let (parsed, _) = parse_single_pair(&toml);
+            prop_assert_eq!(&parsed, &decoded, "key {:?} written as {:?}", decoded, encoded);
+        }
+    }
+}
+
+proptest! {
+    // proob:01M63H6WNZ6Z3YE9CN81PAXBBM
+    #[test]
+    fn every_written_string_parses_back_unchanged(decoded in any::<String>()) {
+        let string = TomlStringBuilder::new(&decoded);
+        let written = [
+            Some(string.as_default()),
+            string.as_literal(),
+            string.as_ml_literal(),
+            string.as_basic_pretty(),
+            string.as_ml_basic_pretty(),
+            Some(string.as_basic()),
+            Some(string.as_ml_basic()),
+        ];
+        for encoded in written.into_iter().flatten().map(|s| s.to_toml_value()) {
+            let toml = format!("k = {encoded}");
+            let (_, parsed) = parse_single_pair(&toml);
+            prop_assert_eq!(parsed.as_str(), Some(decoded.as_str()), "string {:?} written as {:?}", decoded, encoded);
+        }
+    }
+}
