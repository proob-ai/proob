diff --git a/crates/toml/tests/serde/roundtrip.rs b/crates/toml/tests/serde/roundtrip.rs
new file mode 100644
index 0000000..e21801f
--- /dev/null
+++ b/crates/toml/tests/serde/roundtrip.rs
@@ -0,0 +1,117 @@
+use std::collections::BTreeMap;
+
+use proptest::prelude::*;
+use serde::ser::SerializeStruct;
+use toml_writer::ToTomlKey;
+use toml_writer::TomlKeyBuilder;
+
+use crate::SerdeTable;
+use crate::SerdeValue;
+
+#[derive(Debug, Clone)]
+enum Field {
+    Integer(i64),
+    Table(BTreeMap<String, i64>),
+    ArrayOfTables(Vec<BTreeMap<String, i64>>),
+}
+
+impl serde::Serialize for Field {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        match self {
+            Field::Integer(i) => i.serialize(serializer),
+            Field::Table(t) => t.serialize(serializer),
+            Field::ArrayOfTables(a) => a.serialize(serializer),
+        }
+    }
+}
+
+/// A struct whose field names are chosen at run time, as `#[serde(rename)]` chooses them at
+/// compile time
+#[derive(Debug)]
+struct Struct(BTreeMap<String, Field>);
+
+impl serde::Serialize for Struct {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut s = serializer.serialize_struct("Struct", self.0.len())?;
+        for (name, field) in &self.0 {
+            let name: &'static str = Box::leak(name.clone().into_boxed_str());
+            s.serialize_field(name, field)?;
+        }
+        s.end()
+    }
+}
+
+fn table_of(map: &BTreeMap<String, i64>) -> SerdeValue {
+    SerdeValue::Table(map.iter().map(|(k, v)| (k.clone(), SerdeValue::Integer(*v))).collect())
+}
+
+fn expected(s: &Struct) -> SerdeTable {
+    let value_of = |field: &Field| match field {
+        Field::Integer(i) => SerdeValue::Integer(*i),
+        Field::Table(t) => table_of(t),
+        Field::ArrayOfTables(a) => SerdeValue::Array(a.iter().map(table_of).collect()),
+    };
+    s.0.iter().map(|(k, f)| (k.clone(), value_of(f))).collect()
+}
+
+fn name() -> impl Strategy<Value = String> {
+    prop_oneof![any::<String>(), "[a-z0-9 ._=()\"'\\\\-]{0,8}"]
+}
+
+fn field() -> impl Strategy<Value = Field> {
+    let table = || prop::collection::btree_map(name(), any::<i64>(), 0..3);
+    prop_oneof![
+        any::<i64>().prop_map(Field::Integer),
+        table().prop_map(Field::Table),
+        prop::collection::vec(table(), 0..3).prop_map(Field::ArrayOfTables),
+    ]
+}
+
+proptest! {
+    // proob:01M63H6WKPW8HC8YXV0X52NEB7
+    #[test]
+    fn serialized_value_reads_back_equal(fields in prop::collection::btree_map(name(), field(), 0..4)) {
+        let value = Struct(fields);
+        for pretty in [false, true] {
+            let toml = if pretty { crate::to_string_pretty(&value) } else { crate::to_string(&value) };
+            let toml = toml.unwrap_or_else(|err| panic!("{value:?} did not serialize: {err}"));
+            let read = crate::from_str::<SerdeTable>(&toml);
+            prop_assert!(read.is_ok(), "{:?} serialized (pretty={}) as\n{}\ndid not read back: {}", value, pretty, toml, read.unwrap_err());
+            prop_assert_eq!(read.unwrap(), expected(&value), "{:?} serialized (pretty={}) as\n{}", value, pretty, toml);
+        }
+    }
+}
+
+/// Ways a document can define one key twice in the same table; `{k}` is the key as written
+const DUPLICATES: &[&str] = &[
+    "{k} = 1\n{k} = 2\n",
+    "{k} = 1\n[{k}]\n",
+    "[{k}]\n[{k}]\n",
+    "[t]\n{k} = 1\n{k} = 2\n",
+    "t.{k} = 1\nt.{k} = 2\n",
+    "t = { {k} = 1, {k} = 2 }\n",
+    "[t]\n{k} = 1\n[t.{k}]\n",
+    "{k}.a = 1\n{k} = 2\n",
+    "{k} = []\n[[{k}]]\n",
+];
+
+proptest! {
+    // proob:01M63H6WQ2HQCE539VWXQDX2YC
+    #[test]
+    fn same_key_twice_is_rejected(
+        decoded in name(),
+        spellings in (0usize..3, 0usize..3),
+        shape in 0..DUPLICATES.len(),
+    ) {
+        let builder = TomlKeyBuilder::new(&decoded);
+        let written = [builder.as_default(), builder.as_basic(), builder.as_literal().unwrap_or(builder.as_basic())];
+        let (first, second) = (written[spellings.0].to_toml_key(), written[spellings.1].to_toml_key());
+        // the first occurrence of {k} gets one spelling, the rest the other
+        let parts: Vec<&str> = DUPLICATES[shape].split("{k}").collect();
+        let doc = format!("{}{}{}{}", parts[0], first, parts[1], parts[2..].join(&second));
+        let as_table = crate::from_str::<SerdeTable>(&doc);
+        prop_assert!(as_table.is_err(), "duplicate {:?} accepted as a table:\n{}\n{:?}", decoded, doc, as_table);
+        let as_any = crate::from_str::<serde::de::IgnoredAny>(&doc);
+        prop_assert!(as_any.is_err(), "duplicate {:?} accepted when ignored:\n{}", decoded, doc);
+    }
+}
