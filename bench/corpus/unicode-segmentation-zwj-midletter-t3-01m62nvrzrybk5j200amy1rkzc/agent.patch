+    // proob:01M62NVS0X146Z6RPRPGFNZPHV
+    #[test]
+    fn proptest_pieces_join_to_original(s in segmentation_string()) {
+        fn joined<'a>(it: impl Iterator<Item = &'a str>) -> String { it.collect() }
+        for extended in [true, false] {
+            proptest::prop_assert_eq!(joined(s.graphemes(extended)), s.clone(), "graphemes({}) of {:?}", extended, s);
+            let mut rev: Vec<&str> = s.graphemes(extended).rev().collect();
+            rev.reverse();
+            proptest::prop_assert_eq!(rev.concat(), s.clone(), "graphemes({}).rev() of {:?}", extended, s);
+        }
+        proptest::prop_assert_eq!(joined(s.split_word_bounds()), s.clone(), "split_word_bounds of {:?}", s);
+        let mut rev: Vec<&str> = s.split_word_bounds().rev().collect();
+        rev.reverse();
+        proptest::prop_assert_eq!(rev.concat(), s.clone(), "split_word_bounds().rev() of {:?}", s);
+        proptest::prop_assert_eq!(joined(s.split_sentence_bounds()), s.clone(), "split_sentence_bounds of {:?}", s);
+        // Index variants: each piece sits at the offset it reports, contiguously.
+        let mut at = 0;
+        for (i, w) in s.split_word_bound_indices() {
+            proptest::prop_assert_eq!(i, at, "word piece {:?} of {:?}", w, s);
+            at += w.len();
+        }
+        let mut at = 0;
+        for (i, g) in s.grapheme_indices(true) {
+            proptest::prop_assert_eq!(i, at, "grapheme piece {:?} of {:?}", g, s);
+            at += g.len();
+        }
+    }
