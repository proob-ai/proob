+    // proob:01M62NVRZRYBK5J200AMY1RKZC
+    #[test]
+    fn proptest_words_follow_uax29_zwj_after_mid(
+        word in proptest::sample::select(&["a", "Zz", "\u{05D0}", "ab"][..]),
+        number in proptest::sample::select(&["1", "42"][..]),
+        mid_letter in proptest::sample::select(&[":", "\u{00B7}", "'", "."][..]),
+        mid_num in proptest::sample::select(&[",", ";", "'", "."][..]),
+        extend in proptest::sample::select(&["", "\u{0308}", "\u{00AD}"][..]),
+        emoji in proptest::sample::select(&["\u{1F6D1}", "\u{1F600}", "\u{00A9}"][..]),
+        use_number in proptest::prelude::any::<bool>(),
+        row in 0..testdata::TEST_WORD.len(),
+    ) {
+        // UAX #29: a mid character joins only between two letters (WB6/WB7) or two
+        // digits (WB11/WB12); with an emoji after it, the text breaks before the
+        // mid character, and WB4 plus WB3c keep "mid Extend* ZWJ emoji" together.
+        let (head, mid) = if use_number { (number, mid_num) } else { (word, mid_letter) };
+        let tail = format!("{}{}\u{200D}{}", mid, extend, emoji);
+        let s = format!("{}{}", head, tail);
+        let expected = vec![head, tail.as_str()];
+        let forward: Vec<&str> = s.split_word_bounds().collect();
+        let mut backward: Vec<&str> = s.split_word_bounds().rev().collect();
+        backward.reverse();
+        proptest::prop_assert_eq!(&forward, &expected, "forward split of {:?}", s);
+        proptest::prop_assert_eq!(&backward, &expected, "reverse split of {:?}", s);
+        // And the official WordBreakTest row picked by the generator, both directions.
+        let (text, want) = testdata::TEST_WORD[row];
+        let got: Vec<&str> = text.split_word_bounds().collect();
+        proptest::prop_assert_eq!(&got[..], want, "WordBreakTest row {} {:?}", row, text);
+        let mut got_rev: Vec<&str> = text.split_word_bounds().rev().collect();
+        got_rev.reverse();
+        proptest::prop_assert_eq!(&got_rev[..], want, "WordBreakTest row {} reversed {:?}", row, text);
+    }
