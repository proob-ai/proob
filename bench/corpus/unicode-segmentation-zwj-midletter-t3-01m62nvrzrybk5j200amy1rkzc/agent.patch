+/// Characters that drive the segmentation rules (CR/LF, ZWJ, Extend, Format,
+/// MidLetter/MidNum/MidNumLet, regional indicators, Hangul, Indic linkers,
+/// Prepend, Extended_Pictographic, Katakana, ExtendNumLet), mixed with any
+/// char so the whole code-point range stays in the domain.
+fn segmentation_char() -> impl proptest::strategy::Strategy<Value = char> {
+    use proptest::prelude::*;
+    const POOL: &[char] = &[
+        'a', 'Z', '1', ' ', '\r', '\n', '\t', ':', ',', '.', '\'', ';', '_', '"', '!', '?',
+        '\u{05D0}', '\u{0300}', '\u{0308}', '\u{00AD}', '\u{200B}', '\u{200C}', '\u{200D}',
+        '\u{2060}', '\u{FE0F}', '\u{1F3FF}', '\u{1F1E6}', '\u{1F1E8}', '\u{1100}', '\u{1161}',
+        '\u{11A8}', '\u{AC00}', '\u{AC01}', '\u{094D}', '\u{0915}', '\u{093F}', '\u{0600}',
+        '\u{06DD}', '\u{00A9}', '\u{1F600}', '\u{1F6D1}', '\u{30A2}', '\u{3000}', '\u{0085}',
+        '\u{2028}', '\u{3002}', '\u{FF0E}', '\u{0E01}',
+    ];
+    prop_oneof![4 => proptest::sample::select(POOL), 1 => any::<char>()]
+}
+
+fn segmentation_string() -> impl proptest::strategy::Strategy<Value = String> {
+    use proptest::prelude::*;
+    proptest::collection::vec(segmentation_char(), 0..24).prop_map(|v| v.into_iter().collect())
+}
+
+/// Grapheme boundaries of `s`, start and end included, from the whole-string iterator.
+fn whole_string_grapheme_boundaries(s: &str, is_extended: bool) -> Vec<usize> {
+    std::iter::once(0)
+        .chain(s.grapheme_indices(is_extended).map(|(i, g)| i + g.len()))
+        .collect()
+}
+
+/// Splits `s` at the given char-boundary cut points into (start, chunk) pairs.
+fn chunks_at(s: &str, cuts: &[usize]) -> Vec<(usize, String)> {
+    let mut points: Vec<usize> = cuts
+        .iter()
+        .map(|&c| c % (s.len() + 1))
+        .filter(|&c| s.is_char_boundary(c))
+        .chain([0, s.len()])
+        .collect();
+    points.sort_unstable();
+    points.dedup();
+    let pieces: Vec<(usize, String)> = points
+        .windows(2)
+        .map(|w| (w[0], s[w[0]..w[1]].to_string()))
+        .collect();
+    if pieces.is_empty() {
+        vec![(0, String::new())]
+    } else {
+        pieces
+    }
+}
+
+fn chunk_index(chunks: &[(usize, String)], offset: usize) -> usize {
+    chunks
+        .iter()
+        .rposition(|(start, c)| *start <= offset && offset <= start + c.len())
+        .unwrap_or(0)
+}
+
+/// Walks a `GraphemeCursor` over the chunks with `next_boundary`, answering
+/// every `PreContext` and `NextChunk` request, and returns every boundary seen.
+fn chunked_forward_boundaries(s: &str, chunks: &[(usize, String)], is_extended: bool) -> Vec<usize> {
+    use unicode_segmentation::{GraphemeCursor, GraphemeIncomplete};
+    let mut cursor = GraphemeCursor::new(0, s.len(), is_extended);
+    let mut out = vec![0];
+    let mut ci = 0;
+    loop {
+        let (start, chunk) = &chunks[ci];
+        match cursor.next_boundary(chunk, *start) {
+            Ok(Some(b)) => out.push(b),
+            Ok(None) => break,
+            Err(GraphemeIncomplete::NextChunk) => ci += 1,
+            Err(GraphemeIncomplete::PreContext(n)) => {
+                let (pstart, pchunk) = &chunks[chunk_index(chunks, n - 1)];
+                cursor.provide_context(&pchunk[..n - pstart], *pstart);
+            }
+            Err(e) => panic!("{:?} chunks {:?}: unexpected {:?}", s, chunks, e),
+        }
+    }
+    if s.is_empty() {
+        out.dedup();
+    }
+    out
+}
+
+/// Same walk backwards with `prev_boundary`, returned in ascending order.
+fn chunked_backward_boundaries(s: &str, chunks: &[(usize, String)], is_extended: bool) -> Vec<usize> {
+    use unicode_segmentation::{GraphemeCursor, GraphemeIncomplete};
+    let mut cursor = GraphemeCursor::new(s.len(), s.len(), is_extended);
+    let mut out = vec![s.len()];
+    let mut ci = chunks.len() - 1;
+    loop {
+        let (start, chunk) = &chunks[ci];
+        match cursor.prev_boundary(chunk, *start) {
+            Ok(Some(b)) => out.push(b),
+            Ok(None) => break,
+            Err(GraphemeIncomplete::PrevChunk) => ci -= 1,
+            Err(GraphemeIncomplete::PreContext(n)) => {
+                let (pstart, pchunk) = &chunks[chunk_index(chunks, n - 1)];
+                cursor.provide_context(&pchunk[..n - pstart], *pstart);
+            }
+            Err(e) => panic!("{:?} chunks {:?}: unexpected {:?}", s, chunks, e),
+        }
+    }
+    out.reverse();
+    if s.is_empty() {
+        out.dedup();
+    }
+    out
+}
