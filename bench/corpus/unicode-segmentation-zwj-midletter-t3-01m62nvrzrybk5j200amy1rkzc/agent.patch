+    // proob:01M62NVRYMJAX04PH0NVW6N3B6
+    #[test]
+    fn proptest_segmentation_never_panics(
+        s in segmentation_string(),
+        offsets in proptest::collection::vec(proptest::prelude::any::<usize>(), 0..6),
+        is_extended in proptest::prelude::any::<bool>(),
+    ) {
+        use unicode_segmentation::GraphemeCursor;
+        // Drive every public iterator to exhaustion in both directions.
+        let _ = s.graphemes(is_extended).count() + s.graphemes(is_extended).rev().count();
+        let _ = s.grapheme_indices(is_extended).count() + s.grapheme_indices(is_extended).rev().count();
+        let _ = s.unicode_words().count() + s.unicode_words().rev().count();
+        let _ = s.unicode_word_indices().count() + s.unicode_word_indices().rev().count();
+        let _ = s.split_word_bounds().count() + s.split_word_bounds().rev().count();
+        let _ = s.split_word_bound_indices().count() + s.split_word_bound_indices().rev().count();
+        let _ = s.unicode_sentences().count();
+        let _ = s.split_sentence_bounds().count();
+        let _ = s.split_sentence_bound_indices().count();
+        // Ask a cursor about any offset, in range or not, on a char boundary or not.
+        let probes = offsets.iter().map(|&o| o % (s.len() + 3));
+        for offset in probes {
+            let mut c = GraphemeCursor::new(offset, s.len(), is_extended);
+            let _ = c.is_boundary(&s, 0);
+            let mut c = GraphemeCursor::new(offset, s.len(), is_extended);
+            let _ = c.next_boundary(&s, 0);
+            let mut c = GraphemeCursor::new(offset, s.len(), is_extended);
+            let _ = c.prev_boundary(&s, 0);
+        }
+    }
