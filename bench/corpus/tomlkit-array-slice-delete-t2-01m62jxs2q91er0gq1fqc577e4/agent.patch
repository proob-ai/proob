+
+def _plain(value: Any) -> Any:
+    """Unwrapped value with NaN made comparable."""
+    if isinstance(value, float) and math.isnan(value):
+        return "nan"
+    if isinstance(value, dict):
+        return {k: _plain(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_plain(v) for v in value]
+    return value
+
+
+def _array_keys(n: int) -> st.SearchStrategy[int | slice]:
+    bound = st.one_of(st.none(), st.integers(-n - 2, n + 2))
+    step = st.one_of(st.none(), st.integers(-3, 3).filter(bool))
+    slices = st.builds(slice, bound, bound, step)
+    return st.one_of(st.integers(-n, n - 1), slices) if n else slices
+
+
+# proob:01M62JXS1NVVMQ1PGN0JK81RAH
+@given(text=array_text(elements=integers.map(str)), data=st.data())
+def test_array_delete_keeps_rendered_text_in_step(text: str, data: st.DataObject):
+    doc = parse(f"a = {text}\n")
+    expected = doc["a"].unwrap()
+    for _ in range(data.draw(st.integers(1, 3), label="deletions")):
+        key = data.draw(_array_keys(len(expected)), label="key")
+        del expected[key]
+        del doc["a"][key]
+        rendered = doc.as_string()
+        assert parse(rendered)["a"] == expected, (text, key, rendered)
+
+
+def _edit(doc: TOMLDocument, data: st.DataObject) -> None:
+    tables = [doc] + [v for v in doc.values() if isinstance(v, dict)]
+    target = data.draw(st.sampled_from(tables), label="target")
+    arrays = [k for k, v in target.items() if isinstance(v, list)]
+    ops = ["set"] + (["del"] if target else []) + (["array"] if arrays else [])
+    op = data.draw(st.sampled_from(ops), label="op")
+    if op == "set":
+        new = st.one_of(
+            integers, st.text(max_size=5), st.lists(integers, max_size=3),
+            st.dictionaries(keys, integers, max_size=2),
+        )
+        target[data.draw(keys, label="key")] = data.draw(new, label="value")
+    elif op == "del":
+        del target[data.draw(st.sampled_from(list(target)), label="key")]
+    else:
+        arr = target[data.draw(st.sampled_from(arrays), label="array")]
+        how = data.draw(st.sampled_from(["append", "insert", "del"]), label="how")
+        n = len(arr)
+        if how == "append":
+            arr.append(data.draw(integers, label="item"))
+        elif how == "insert":
+            arr.insert(data.draw(st.integers(-n - 1, n + 1)), data.draw(integers))
+        elif n:
+            del arr[data.draw(_array_keys(n), label="index")]
+
+
+# proob:01M62JXS3NQPYTVABWWFM5TBM1
+@given(text=document_text(), data=st.data())
+def test_edited_document_reparses_to_same_values(text: str, data: st.DataObject):
+    doc = parse(text)
+    for _ in range(data.draw(st.integers(1, 4), label="edits")):
+        _edit(doc, data)
+        rendered = doc.as_string()
+        assert _plain(parse(rendered).unwrap()) == _plain(doc.unwrap()), rendered
