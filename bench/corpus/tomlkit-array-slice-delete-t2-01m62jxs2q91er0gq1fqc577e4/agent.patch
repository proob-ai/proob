diff --git a/tests/strategies.py b/tests/strategies.py
new file mode 100644
index 0000000..9b97c26
--- /dev/null
+++ b/tests/strategies.py
@@ -0,0 +1,83 @@
+"""Hypothesis strategies that build TOML text with varied, valid formatting."""
+
+from __future__ import annotations
+
+import json
+
+from hypothesis import strategies as st
+
+
+keys = st.from_regex(r"[a-z_][a-z0-9_-]{0,7}", fullmatch=True)
+integers = st.integers(min_value=-(2**63), max_value=2**63 - 1)
+
+# Control characters and DEL must be escaped in basic strings; json.dumps
+# escapes the former, so DEL and surrogates are excluded from the alphabet.
+_text = st.text(
+    alphabet=st.characters(blacklist_categories=("Cs",), blacklist_characters="\x7f"),
+    max_size=8,
+)
+_literal = st.text(
+    alphabet=st.characters(
+        blacklist_categories=("Cs", "Cc"), blacklist_characters="'\x7f"
+    ),
+    max_size=8,
+)
+
+scalars = st.one_of(
+    integers.map(str),
+    st.sampled_from(["true", "false", "1.5", "-0.25", "1e3", "inf", "nan"]),
+    _text.map(lambda s: json.dumps(s, ensure_ascii=False)),
+    _literal.map(lambda s: f"'{s}'"),
+    st.sampled_from(["1979-05-27", "07:32:00", "1979-05-27T07:32:00Z"]),
+)
+
+# Whitespace allowed between array elements and commas, comments included.
+array_ws = st.sampled_from(["", " ", "  ", "\t", "\n", "\n    ", " # note\n  "])
+line_ws = st.sampled_from(["", " ", "  ", "\t"])
+
+
+@st.composite
+def array_text(draw, elements=scalars, max_size=8) -> str:
+    """An array literal of `elements`, in any mix of inline, multiline,
+    comma-last, comma-first, and trailing-comma styles."""
+    items = draw(st.lists(elements, max_size=max_size))
+    parts = ["["]
+    for i, item in enumerate(items):
+        parts.append(draw(array_ws) + item + draw(array_ws))
+        if i < len(items) - 1 or draw(st.booleans()):
+            parts.append(",")
+    parts.append(draw(array_ws) + "]")
+    return "".join(parts)
+
+
+@st.composite
+def inline_table_text(draw) -> str:
+    names = draw(st.lists(keys, unique=True, max_size=3))
+    pairs = [f"{k}{draw(line_ws)}={draw(line_ws)}{draw(scalars)}" for k in names]
+    return "{" + draw(line_ws) + ", ".join(pairs) + draw(line_ws) + "}"
+
+
+values = st.one_of(scalars, array_text(), inline_table_text())
+
+
+@st.composite
+def _section(draw) -> list[str]:
+    lines = []
+    for k in draw(st.lists(keys, unique=True, max_size=5)):
+        comment = draw(st.sampled_from(["", " # c", "  #"]))
+        lines.append(
+            f"{draw(line_ws)}{k}{draw(line_ws)}={draw(line_ws)}{draw(values)}{comment}"
+        )
+        if draw(st.booleans()):
+            lines.append(draw(st.sampled_from(["", "# comment", "  "])))
+    return lines
+
+
+@st.composite
+def document_text(draw) -> str:
+    """A whole document: top-level pairs, then uniquely named tables."""
+    lines = draw(_section())
+    for name in draw(st.lists(keys, unique=True, max_size=3)):
+        lines.append(f"[tbl-{name}]")
+        lines.extend(draw(_section()))
+    return "\n".join(lines) + draw(st.sampled_from(["", "\n"]))
