+def test_write_keeps_line_endings(text: str, eol: str, edit: int | None) -> None:
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, "f.toml")
+        with open(path, "wb") as fh:
+            fh.write(text.replace("\n", eol).encode())
+        toml_f = TOMLFile(path)
+        doc = toml_f.read()
+        if edit is not None:
+            doc["proob-new"] = edit
+        toml_f.write(doc)
+        with open(path, "rb") as fh:
+            out = fh.read().decode()
+    stray = "\n" in out.replace("\r\n", "") if eol == "\r\n" else "\r" in out
+    assert not stray, (eol, out)
