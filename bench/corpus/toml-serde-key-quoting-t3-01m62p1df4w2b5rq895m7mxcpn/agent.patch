+#[track_caller]
+fn read_back(toml: &str) -> (String, toml_old::Value) {
+    let value = match toml.parse::<toml_old::Value>() {
+        Ok(value) => value,
+        Err(err) => panic!("could not parse {toml:?}: {err}"),
+    };
+    let table = value.as_table().unwrap();
+    assert_eq!(table.len(), 1, "{toml:?} read as {table:?}");
+    let (key, value) = table.iter().next().unwrap();
+    (key.clone(), value.clone())
+}
+
+proptest! {
+    // proob:01M62P1DG83RRRVFV2RY5FYTXF
+    #[test]
+    fn every_key_form_reads_back_unchanged(decoded in any::<String>()) {
+        let key = TomlKeyBuilder::new(&decoded);
+        let forms = [
+            ("default", Some(key.as_default())),
+            ("unquoted", key.as_unquoted()),
+            ("literal", key.as_literal()),
+            ("basic_pretty", key.as_basic_pretty()),
+            ("basic", Some(key.as_basic())),
+        ];
+        for (form, encoded) in forms {
+            let Some(encoded) = encoded else { continue };
+            let toml = format!("{} = 0", encoded.to_toml_key());
+            let (read, _) = read_back(&toml);
+            prop_assert_eq!(&read, &decoded, "{} key written as {:?}", form, toml);
+        }
+    }
+}
+
+proptest! {
+    // proob:01M62P1DHEVDDGJ1CND61FYQ56
+    #[test]
+    fn every_string_form_reads_back_unchanged(decoded in any::<String>()) {
+        let string = TomlStringBuilder::new(&decoded);
+        let forms = [
+            ("default", Some(string.as_default())),
+            ("literal", string.as_literal()),
+            ("ml_literal", string.as_ml_literal()),
+            ("basic_pretty", string.as_basic_pretty()),
+            ("ml_basic_pretty", string.as_ml_basic_pretty()),
+            ("basic", Some(string.as_basic())),
+            ("ml_basic", Some(string.as_ml_basic())),
+        ];
+        for (form, encoded) in forms {
+            let Some(encoded) = encoded else { continue };
+            let toml = format!("k = {}", encoded.to_toml_value());
+            let (_, read) = read_back(&toml);
+            prop_assert_eq!(read.as_str(), Some(decoded.as_str()), "{} string written as {:?}", form, toml);
+        }
+    }
+}
