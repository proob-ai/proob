+#[cfg(test)]
+mod test {
+    use proptest::prelude::*;
+
+    /// Fragments of TOML syntax, so most cases get past the first token instead of failing on it
+    fn toml_ish() -> impl Strategy<Value = String> {
+        let piece = prop_oneof![
+            any::<char>().prop_map(String::from),
+            prop::sample::select(vec![
+                "[", "]", "[[", "]]", "{", "}", "=", ".", ",", "\n", "\r\n", " ", "#", "\"", "'",
+                "\"\"\"", "'''", "\\", "\\u", "a", "b", "1", "-", "+", "_", "0x", "0o", "0b",
+                "1e5", "1.0", "inf", "nan", "true", "false", "1979-05-27", "T07:32:00", "Z",
+                "+07:00", "a = 1", "[a]", "[[a]]", "a.b", "a = {", "a = [",
+            ])
+            .prop_map(String::from),
+        ];
+        prop::collection::vec(piece, 0..64).prop_map(|v| v.concat())
+    }
+
+    proptest! {
+        // proob:01M62P1DKK7GZNXP02PDDRXBJG
+        #[test]
+        fn reading_any_text_never_panics(input in prop_oneof![any::<String>(), toml_ish()]) {
+            let read = std::panic::catch_unwind(|| {
+                let _ = input.parse::<crate::DocumentMut>();
+                let _ = input.parse::<crate::Document<String>>();
+                let _ = input.parse::<crate::Value>();
+                let _ = input.parse::<crate::Key>();
+                let _ = crate::Key::parse(&input);
+            });
+            prop_assert!(read.is_ok(), "reading panicked on {:?}", input);
+        }
+    }
+}
