+mod roundtrip_names {
+    use proptest::prelude::*;
+    use serde::ser::{SerializeStruct, SerializeStructVariant};
+
+    /// How a named field is written: a key-value pair, a `[table]`, an `[[array]]` of tables, or
+    /// a struct-variant enum whose variant name is also arbitrary
+    #[derive(Debug, Clone)]
+    enum Field {
+        Plain(i64),
+        Table(i64),
+        Tables(Vec<i64>),
+        Variant(&'static str, i64),
+    }
+
+    struct Inner(i64);
+
+    impl serde::Serialize for Inner {
+        fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+            let mut st = s.serialize_struct("Inner", 1)?;
+            st.serialize_field("value", &self.0)?;
+            st.end()
+        }
+    }
+
+    impl serde::Serialize for Field {
+        fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+            match self {
+                Field::Plain(v) => s.serialize_i64(*v),
+                Field::Table(v) => Inner(*v).serialize(s),
+                Field::Tables(vs) => s.collect_seq(vs.iter().map(|v| Inner(*v))),
+                Field::Variant(name, v) => {
+                    let mut sv = s.serialize_struct_variant("Variant", 0, name, 1)?;
+                    sv.serialize_field("value", v)?;
+                    sv.end()
+                }
+            }
+        }
+    }
+
+    /// A struct whose field names are chosen at runtime, as `#[serde(rename)]` would
+    #[derive(Debug, Clone)]
+    struct Doc(Vec<(&'static str, Field)>);
+
+    impl serde::Serialize for Doc {
+        fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+            let mut st = s.serialize_struct("Doc", self.0.len())?;
+            for (name, field) in &self.0 {
+                st.serialize_field(name, field)?;
+            }
+            st.end()
+        }
+    }
+
+    fn inner(v: i64) -> toml::Value {
+        toml::Value::Table(toml::Table::from_iter([("value".to_owned(), v.into())]))
+    }
+
+    fn expected(doc: &Doc) -> toml::Table {
+        doc.0
+            .iter()
+            .map(|(name, field)| {
+                let value = match field {
+                    Field::Plain(v) => (*v).into(),
+                    Field::Table(v) => inner(*v),
+                    Field::Tables(vs) => toml::Value::Array(vs.iter().map(|v| inner(*v)).collect()),
+                    Field::Variant(variant, v) => toml::Value::Table(toml::Table::from_iter([(
+                        (*variant).to_owned(),
+                        inner(*v),
+                    )])),
+                };
+                ((*name).to_owned(), value)
+            })
+            .collect()
+    }
+
+    fn leak(s: String) -> &'static str {
+        Box::leak(s.into_boxed_str())
+    }
+
+    fn field() -> impl Strategy<Value = Field> {
+        prop_oneof![
+            any::<i64>().prop_map(Field::Plain),
+            any::<i64>().prop_map(Field::Table),
+            prop::collection::vec(any::<i64>(), 1..3).prop_map(Field::Tables),
+            (any::<String>(), any::<i64>()).prop_map(|(n, v)| Field::Variant(leak(n), v)),
+        ]
+    }
+
+    fn doc() -> impl Strategy<Value = Doc> {
+        prop::collection::btree_map(any::<String>(), field(), 1..4)
+            .prop_map(|m| Doc(m.into_iter().map(|(k, f)| (leak(k), f)).collect()))
+    }
+
+    proptest! {
+        // proob:01M62P1DF4W2B5RQ895M7MXCPN
+        #[test]
+        fn write_then_read_is_equal_for_any_names(doc in doc()) {
+            let want = expected(&doc);
+            for (style, written) in [
+                ("to_string", toml::to_string(&doc)),
+                ("to_string_pretty", toml::to_string_pretty(&doc)),
+            ] {
+                let written = written.unwrap_or_else(|e| panic!("{style} failed: {e}\nfields: {:?}", doc.0));
+                let read = toml::from_str::<toml::Table>(&written).unwrap_or_else(|e| {
+                    panic!("{style} wrote a document that does not read back\nfields: {:?}\ndocument:\n{written}\nerror: {e}", doc.0)
+                });
+                prop_assert_eq!(&read, &want, "{} document:\n{}", style, written);
+            }
+        }
+    }
+}
