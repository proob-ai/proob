+mod duplicate_keys {
+    use proptest::prelude::*;
+    use toml_writer::{ToTomlKey, TomlKeyBuilder};
+
+    /// Every way the writer can spell `key`; TOML treats them all as the same key
+    fn spellings(key: &str) -> Vec<String> {
+        let b = TomlKeyBuilder::new(key);
+        [
+            Some(b.as_default()),
+            b.as_unquoted(),
+            b.as_literal(),
+            b.as_basic_pretty(),
+            Some(b.as_basic()),
+        ]
+        .into_iter()
+        .flatten()
+        .map(|k| k.to_toml_key())
+        .collect()
+    }
+
+    /// Documents that define the key named by `a` and again by `b`
+    fn repeats(a: &str, b: &str) -> Vec<String> {
+        vec![
+            format!("{a} = 1\n{b} = 2\n"),
+            format!("t = {{ {a} = 1, {b} = 2 }}\n"),
+            format!("[{a}]\n[{b}]\n"),
+            format!("{a} = 1\n[{b}]\n"),
+            format!("[{a}]\nx = 1\n[[{b}]]\n"),
+            format!("t.{a} = 1\nt.{b} = 2\n"),
+            format!("[t]\n{a} = 1\n[t]\n{b} = 2\n"),
+            format!("[t]\n{a}.x = 1\n{b}.x = 2\n"),
+        ]
+    }
+
+    proptest! {
+        // proob:01M62P1DJFTY3W24FCKJDYMKKP
+        #[test]
+        fn a_repeated_key_is_an_error(key in any::<String>(), i in any::<prop::sample::Index>(), j in any::<prop::sample::Index>()) {
+            let names = spellings(&key);
+            let (a, b) = (i.get(&names), j.get(&names));
+            for doc in repeats(a, b) {
+                let read = toml::from_str::<toml::Table>(&doc);
+                prop_assert!(read.is_err(), "key {:?} repeated as {} and {} read as {:?}\ndocument:\n{}", key, a, b, read, doc);
+            }
+        }
+    }
+}
