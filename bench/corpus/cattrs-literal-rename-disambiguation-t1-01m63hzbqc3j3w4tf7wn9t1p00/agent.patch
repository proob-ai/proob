+# proob:01M63HZBSM44ZYGGZGF1QDW0C3
+@settings(suppress_health_check=[HealthCheck.filter_too_much, HealthCheck.too_slow])
+@given(lists(simple_classes(defaults=False), min_size=2, max_size=3))
+def test_disambiguation_order_independent_generated(cls_and_vals):
+    """The class chosen for a payload does not depend on the union's member order."""
+    classes = [cl for cl, _, _ in cls_and_vals]
+    assume(len(set(classes)) == len(classes))
+    payloads = [asdict(cl(*vals, **kwargs)) for cl, vals, kwargs in cls_and_vals]
+    c = Converter()
+
+    def outcome(ordering, payload):
+        try:
+            return create_default_dis_func(c, *ordering)(payload)
+        except Exception as exc:  # noqa: BLE001
+            return type(exc)
+
+    for payload in payloads:
+        results = {o: outcome(o, payload) for o in permutations(classes)}
+        assert len(set(results.values())) == 1, (payload, results)
+
+
+# proob:01M63HZBVV63AEY8CP1VHXCTBK
+@given(
+    shared=lists(_identifiers, max_size=3, unique=True),
+    n=integers(min_value=1, max_value=4),
+    pick=integers(min_value=0, max_value=3),
+)
+def test_unique_required_field_selects_class(shared, n, pick):
+    """A unique required field selects its class; the field-less member is only the fallback."""
+    shared = [f"s_{s}" for s in shared]
+    members = [
+        make_class(f"C{i}", {name: field(type=int) for name in [*shared, f"u{i}"]})
+        for i in range(n)
+    ]
+    fallback = make_class("F", {name: field(type=int) for name in shared})
+    c = Converter()
+    union = Union[(*members, fallback)]
+
+    target = members[pick % n]
+    payload = {name: 0 for name in [*shared, f"u{pick % n}"]}
+    assert type(c.structure(payload, union)) is target, (payload, n)
+
+    only_shared = {name: 0 for name in shared}
+    assert type(c.structure(only_shared, union)) is fallback, (only_shared, n)
