+# proob:01M63HZBQC3J3W4TF7WN9T1P00
+@given(key=_identifiers, via_alias=booleans(), pick_b=booleans(), x=integers())
+def test_renamed_literal_discriminator(key, via_alias, pick_b, x):
+    """A Literal discriminator serialized under a renamed or aliased key picks the right class."""
+    if via_alias:
+
+        @define
+        class A:
+            kind: Literal["a"] = field(alias=key)
+            x: int
+
+        @define
+        class B:
+            kind: Literal["b"] = field(alias=key)
+            x: int
+
+    else:
+
+        @define
+        class A:
+            kind: Literal["a"]
+            x: int
+
+        @define
+        class B:
+            kind: Literal["b"]
+            x: int
+
+    c = Converter(use_alias=via_alias)
+    if not via_alias:
+        for cl in (A, B):
+            c.register_structure_hook(
+                cl, make_dict_structure_fn(cl, c, kind=override(rename=key))
+            )
+
+    cl, lit = (B, "b") if pick_b else (A, "a")
+    expected = cl(**{key if via_alias else "kind": lit, "x": x})
+    payload = {key: lit, "x": x}
+    result = c.structure(payload, Union[A, B])
+    assert result == expected, (payload, via_alias, result)
+
