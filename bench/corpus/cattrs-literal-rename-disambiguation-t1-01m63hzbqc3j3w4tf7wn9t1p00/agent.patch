@@ -1,4 +1,5 @@
 # ruff: noqa: PLC0415
+import os
 import time
 from collections.abc import Callable, Iterator, Set
 from datetime import date, datetime, timezone
@@ -1081,3 +1082,50 @@ def test_naive_datetimes_are_unstructured_as_utc_cbor2(
     from cattrs.preconf.cbor2 import make_converter as cbor2_make_converter
 
     test_naive_datetimes_are_unstructured_as_utc(cbor2_make_converter, set_timezone)
+
+
+_roundtrip_converters = {
+    "json": (json_make_converter, {}),
+    "ujson": (ujson_make_converter, {}),
+    "msgpack": (msgpack_make_converter, {"strict_map_key": False}),
+}
+if not NO_CBOR2:
+    from cattrs.preconf.cbor2 import make_converter as _cbor2_make_converter
+
+    _roundtrip_converters["cbor2"] = (_cbor2_make_converter, {})
+
+
+# proob:01M63HZBTQ3E81HG48HF9XCXKH
+@given(
+    name=sampled_from(sorted(_roundtrip_converters)),
+    everything=everythings(min_int=-9223372036854775808, max_int=9223372036854775807),
+    naive=datetimes(min_value=datetime(1970, 1, 2), max_value=datetime(2038, 1, 1)),
+    zones=lists(
+        sampled_from(["UTC", "America/New_York", "Asia/Kolkata", "Pacific/Auckland"]),
+        min_size=2,
+        max_size=2,
+    ),
+)
+def test_preconf_loads_reverses_dumps(name, everything, naive, zones):
+    """loads reverses dumps, and naive datetimes do not shift with the local timezone."""
+    make, loads_kwargs = _roundtrip_converters[name]
+    converter = make()
+    raw = converter.dumps(everything)
+    back = converter.loads(raw, Everything, **loads_kwargs)
+    assert back == everything, (name, everything, back)
+
+    old_tz = os.environ.get("TZ")
+    seen = []
+    try:
+        for zone in zones:
+            os.environ["TZ"] = zone
+            time.tzset()
+            dumped = converter.dumps(naive)
+            seen.append((zone, dumped, converter.loads(dumped, datetime, **loads_kwargs)))
+    finally:
+        if old_tz is None:
+            os.environ.pop("TZ", None)
+        else:
+            os.environ["TZ"] = old_tz
+        time.tzset()
+    assert seen[0][1:] == seen[1][1:], (name, naive, seen)
