@@ -405,3 +408,96 @@ def test_dataclasses_literals(converter):
 
     assert converter.structure({"a": "a"}, Union[A, B]) == A()
     assert converter.structure({"b": "b"}, Union[A, B]) == B("b")
+
+
+_identifiers = text(ascii_lowercase, min_size=1).filter(
+    lambda s: not iskeyword(s) and s not in ("kind", "x")
