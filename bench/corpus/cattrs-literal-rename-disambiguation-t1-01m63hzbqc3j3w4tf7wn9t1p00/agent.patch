+# proob:01M63HZBRHECS4FWZETXXSRG6J
+@given(
+    simple_typed_classes(allow_nan=False) | simple_typed_dataclasses(allow_nan=False),
+    booleans(),
+    booleans(),
+    one_of(just(None), sampled_from(["k_", "renamed '\" "])),
+)
+def test_roundtrip_with_overrides(cls_and_vals, omit_if_default, use_alias, prefix):
+    """Unstructure then structure gives back an equal value, with renames, aliases and omit_if_default."""
+    converter = Converter(omit_if_default=omit_if_default, use_alias=use_alias)
+    cl, vals, kwargs = cls_and_vals
+    if prefix is not None:
+        renames = {
+            a.name: override(rename=f"{prefix}{a.name}") for a in adapted_fields(cl)
+        }
+        converter.register_structure_hook(
+            cl, make_dict_structure_fn(cl, converter, **renames)
+        )
+        converter.register_unstructure_hook(
+            cl, make_dict_unstructure_fn(cl, converter, **renames)
+        )
+    inst = cl(*vals, **kwargs)
+    unstructured = converter.unstructure(inst)
+    structured = converter.structure(unstructured, cl)
+    assert structured == inst, (inst, unstructured, structured)
