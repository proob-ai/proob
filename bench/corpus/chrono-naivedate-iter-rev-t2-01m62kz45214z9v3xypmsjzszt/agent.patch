+//! Property-based checks for the statements under `proob/properties/`.
+#![cfg(feature = "alloc")]
+
+use chrono::{DateTime, Datelike, FixedOffset, NaiveDate, TimeDelta, TimeZone};
+use proptest::prelude::*;
+
+/// Any representable date, MIN and MAX included.
+fn any_date() -> impl Strategy<Value = NaiveDate> {
+    (NaiveDate::MIN.num_days_from_ce()..=NaiveDate::MAX.num_days_from_ce())
+        .prop_map(|n| NaiveDate::from_num_days_from_ce_opt(n).unwrap())
+}
+
+/// A date at most `k` days from either limit, so a walk can reach the limit.
+fn date_near_limit(k: i32) -> impl Strategy<Value = NaiveDate> {
+    (any::<bool>(), 0..=k).prop_map(move |(top, d)| near_limit(top, d))
+}
+
+fn near_limit(top: bool, d: i32) -> NaiveDate {
+    {
+        let n = if top {
+            NaiveDate::MAX.num_days_from_ce() - d
+        } else {
+            NaiveDate::MIN.num_days_from_ce() + d
+        };
+        NaiveDate::from_num_days_from_ce_opt(n).unwrap()
+    }
+}
+
+fn any_or_near_limit() -> impl Strategy<Value = NaiveDate> {
+    prop_oneof![any_date(), date_near_limit(20_000)]
+}
+
+/// Steps a day or week iterator `steps` times, recording `len()` before each step.
+fn step(start: NaiveDate, weeks: bool, back: bool, steps: usize) -> Vec<(usize, Option<NaiveDate>)> {
+    fn run<I: DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator>(
+        mut it: I,
+        back: bool,
+        steps: usize,
+    ) -> Vec<(usize, Option<NaiveDate>)> {
+        (0..steps)
+            .map(|_| (it.len(), if back { it.next_back() } else { it.next() }))
+            .collect()
+    }
+    if weeks {
+        run(start.iter_weeks(), back, steps)
+    } else {
+        run(start.iter_days(), back, steps)
+    }
+}
+
+/// An arbitrary span built by one or two arithmetic operations from raw parts.
+fn any_time_delta() -> impl Strategy<Value = Option<TimeDelta>> {
+    let base = prop_oneof![
+        (any::<i64>(), 0u32..2_000_000_000).prop_map(|(s, n)| TimeDelta::new(s, n)),
+        any::<i64>().prop_map(TimeDelta::try_milliseconds),
+        any::<i64>().prop_map(|n| Some(TimeDelta::nanoseconds(n))),
+        (-(i64::MAX / 1000)..=i64::MAX / 1000).prop_map(|n| Some(TimeDelta::microseconds(n))),
+    ];
+    (base.clone(), base, 0u8..7, any::<i32>()).prop_map(|(a, b, op, k)| {
+        let (a, b) = (a?, b?);
+        match op {
+            0 => Some(a),
+            1 => a.checked_add(&b),
+            2 => a.checked_sub(&b),
+            3 => a.checked_mul(k),
+            4 => a.checked_div(k),
+            5 => Some(a.abs()),
+            _ => Some(-a),
+        }
+    })
+}
+
+proptest! {
+    // proob:01M62KZ43W6ZYZZZ8G9ZDKHX5S
+    #[test]
+    fn rfc3339_offset_never_24h_and_reads_back(
+        off in -86_399i32..=86_399,
+        // RFC 3339 covers four-digit years only.
+        ts in -62_135_596_800i64..=253_402_300_799,
+    ) {
+        let offset = FixedOffset::east_opt(off).unwrap();
+        let dt = offset.timestamp_opt(ts, 0).unwrap();
+        let text = dt.to_rfc3339();
+        prop_assert!(!text.ends_with("+24:00") && !text.ends_with("-24:00"),
+            "offset {}s, timestamp {}: wrote {}", off, ts, text);
+        let back = DateTime::parse_from_rfc3339(&text);
+        prop_assert!(back.is_ok(), "offset {}s, timestamp {}: {} does not parse: {:?}", off, ts, text, back);
+        prop_assert_eq!(back.unwrap().timestamp(), ts,
+            "offset {}s: {} reads back as a different instant", off, text);
+    }
+
+    // proob:01M62KZ45214Z9V3XYPMSJZSZT
+    #[test]
+    fn date_iterator_len_matches_yield(
+        start in any_or_near_limit(),
+        weeks in any::<bool>(),
+        back in any::<bool>(),
+    ) {
+        let steps = step(start, weeks, back, 4_000);
+        for w in steps.windows(2) {
+            let ((len, item), (next_len, _)) = (w[0], w[1]);
+            match item {
+                Some(d) => prop_assert_eq!(next_len + 1, len,
+                    "start {}, weeks {}, back {}: len {} then {} after yielding {}",
+                    start, weeks, back, len, next_len, d),
+                None => prop_assert_eq!(len, 0,
+                    "start {}, weeks {}, back {}: ended while len reported {}",
+                    start, weeks, back, len),
+            }
+        }
+        if let (len, Some(d)) = steps[0] {
+            prop_assert!(len > 0, "start {}: yielded {} while len reported 0", start, d);
+        }
+    }
+
+    // proob:01M62KZ467272R6CFZWZ1E8ZEX
+    #[test]
+    fn date_walks_stop_at_limits(
+        d in 0..=20_000i32,
+        weeks in any::<bool>(),
+        back in any::<bool>(),
+    ) {
+        // Start near the limit the walk heads toward.
+        let start = near_limit(!back, d);
+        let stride = if weeks { 7 } else { 1 };
+        let (limit, mut it): (NaiveDate, Box<dyn Iterator<Item = NaiveDate>>) =
+            match (weeks, back) {
+                (false, false) => (NaiveDate::MAX, Box::new(start.iter_days())),
+                (false, true) => (NaiveDate::MIN, Box::new(start.iter_days().rev())),
+                (true, false) => (NaiveDate::MAX, Box::new(start.iter_weeks())),
+                (true, true) => (NaiveDate::MIN, Box::new(start.iter_weeks().rev())),
+            };
+        let mut last = None;
+        let mut n = 0u32;
+        while let Some(d) = it.next() {
+            prop_assert!(n <= 20_001, "start {}: walk did not stop", start);
+            last = Some(d);
+            n += 1;
+        }
+        prop_assert!(it.next().is_none(), "start {}: walk resumed after ending", start);
+        let remaining = match last {
+            Some(d) => (limit.signed_duration_since(d)).num_days().abs(),
+            None => (limit.signed_duration_since(start)).num_days().abs(),
+        };
+        prop_assert!(remaining <= stride,
+            "start {}, weeks {}, back {}: stopped at {:?}, {} days short of {}",
+            start, weeks, back, last, remaining, limit);
+    }
+
+    // proob:01M62KZ47CQMRQ5KTYMR4412B2
+    #[test]
+    fn time_delta_subsec_normalized(d in any_time_delta()) {
+        if let Some(d) = d {
+            let (s, n) = (d.num_seconds(), d.subsec_nanos());
+            prop_assert!(n.abs() < 1_000_000_000, "{:?}: sub-second part {}", d, n);
+            prop_assert!(n == 0 || s == 0 || (s < 0) == (n < 0),
+                "{:?}: seconds {} and sub-second {} disagree in sign", d, s, n);
+            // The stored field itself, read from the derived Debug output.
+            let debug = format!("{:?}", d);
+            let nanos: u64 = debug.split("nanos: ").nth(1)
+                .and_then(|t| t.split(|c: char| !c.is_ascii_digit()).next())
+                .and_then(|t| t.parse().ok())
+                .expect("Debug shows nanos");
+            prop_assert!(nanos < 1_000_000_000, "{}: stored sub-second part {}", debug, nanos);
+        }
+    }
+
+    // proob:01M62KZ48GZ48H0T5N579KMKKY
+    #[test]
+    fn date_print_parse_roundtrip(d in any_date()) {
+        let text = d.format("%Y-%m-%d").to_string();
+        prop_assert_eq!(text.parse::<NaiveDate>(), Ok(d), "parse of {}", text);
+        prop_assert_eq!(NaiveDate::parse_from_str(&text, "%Y-%m-%d"), Ok(d), "parse_from_str of {}", text);
+        let debug = format!("{:?}", d);
+        prop_assert_eq!(debug.parse::<NaiveDate>(), Ok(d), "parse of debug {}", debug);
+    }
+}
