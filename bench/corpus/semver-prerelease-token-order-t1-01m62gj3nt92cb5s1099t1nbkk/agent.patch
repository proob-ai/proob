--- a/tests/test_optional_native_backend.py
+++ b/tests/test_optional_native_backend.py
@@ -24,3 +24,43 @@ def test_optional_backend_is_available_without_changing_public_objects() -> None
 def test_optional_backend_is_not_used_for_python_only_optional_parts() -> None:
     result = Version.parse("7", optional_minor_and_patch=True)
     assert result.to_tuple() == (7, 0, 0, None, None)
+
+
+# --- property-based checks ---
+from hypothesis import given, strategies as st  # noqa: E402
+_alnum = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-"
+_numeric_id = st.integers(min_value=0).map(str)
+_alpha_id = st.from_regex(r"[0-9]*[a-zA-Z-][0-9a-zA-Z-]*", fullmatch=True).filter(
+    str.isascii
+)
+_identifier = st.one_of(_numeric_id, _alpha_id)
+_dotted = st.lists(_identifier, min_size=1, max_size=4).map(".".join)
+_build = st.lists(st.text(_alnum, min_size=1), min_size=1, max_size=3).map(".".join)
+_number = st.one_of(st.integers(0, 3), st.integers(min_value=0))
+_versions = st.builds(
+    Version, _number, _number, _number, st.none() | _dotted, st.none() | _build
+)
+_texts = st.one_of(
+    _versions.map(str),
+    st.text(),
+    st.from_regex(r"\d+\.\d+\.\d+(-[\w.-]*)?(\+[\w.-]*)?", fullmatch=True),
+)
+
+
+def _outcome(parse_parts, text):
+    saved = version_module._native_parse_parts
+    version_module._native_parse_parts = parse_parts
+    try:
+        return Version.parse(text).to_tuple()
+    except ValueError:
+        return "rejected"
+    finally:
+        version_module._native_parse_parts = saved
+
+
+# proob:01M62GJ3T57T6ERFX69WTBADJR
+@given(_texts)
+def test_native_and_python_parsers_agree(text):
+    native = _outcome(version_module._native_parse_parts, text)
+    python = _outcome(None, text)
+    assert native == python, f"{text!r}: native {native!r}, python {python!r}"
diff --git a/tests/test_parsing.py b/tests/test_parsing.py
