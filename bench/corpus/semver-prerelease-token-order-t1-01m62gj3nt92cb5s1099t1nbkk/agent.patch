 def test_direct_compare_with_invalid_type(other):
     with pytest.raises(TypeError):
         Version(1, 0, 0).compare(other)
+
+
+# --- property-based checks ---
+from functools import cmp_to_key  # noqa: E402
+
+from hypothesis import given, strategies as st  # noqa: E402
+_alnum = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-"
+_numeric_id = st.integers(min_value=0).map(str)
+_alpha_id = st.from_regex(r"[0-9]*[a-zA-Z-][0-9a-zA-Z-]*", fullmatch=True).filter(
+    str.isascii
+)
+_identifier = st.one_of(_numeric_id, _alpha_id)
+_dotted = st.lists(_identifier, min_size=1, max_size=4).map(".".join)
+_build = st.lists(st.text(_alnum, min_size=1), min_size=1, max_size=3).map(".".join)
+_number = st.one_of(st.integers(0, 3), st.integers(min_value=0))
+_versions = st.builds(
+    Version, _number, _number, _number, st.none() | _dotted, st.none() | _build
+)
+
+
+# proob:01M62GJ3PYSQSZQV332011M1S8
+@given(st.lists(_versions, min_size=1, max_size=8), _build)
+def test_comparison_is_a_total_order(versions, build):
+    ordered = sorted(versions, key=cmp_to_key(Version.compare))
+    for i, a in enumerate(ordered):
+        assert a.compare(a.replace(build=build)) == 0, f"{a!s} vs build {build!r}"
+        for b in ordered[i:]:
+            assert a.compare(b) == -b.compare(a), f"{a!s} vs {b!s} not antisymmetric"
+            assert a.compare(b) <= 0, f"sorted order broken: {a!s} after {b!s}"
diff --git a/tests/test_optional_native_backend.py b/tests/test_optional_native_backend.py
