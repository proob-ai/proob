--- a/tests/test_parsing.py
+++ b/tests/test_parsing.py
@@ -216,3 +216,51 @@ def test_next_version_with_versioninfo(version, part, expected):
     next_version = ver.next_version(part)
     assert isinstance(next_version, Version)
     assert str(next_version) == expected
+
+
+# --- property-based checks ---
+from hypothesis import given, strategies as st  # noqa: E402
+_alnum = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-"
+_numeric_id = st.integers(min_value=0).map(str)
+_alpha_id = st.from_regex(r"[0-9]*[a-zA-Z-][0-9a-zA-Z-]*", fullmatch=True).filter(
+    str.isascii
+)
+_identifier = st.one_of(_numeric_id, _alpha_id)
+_dotted = st.lists(_identifier, min_size=1, max_size=4).map(".".join)
+_build = st.lists(st.text(_alnum, min_size=1), min_size=1, max_size=3).map(".".join)
+_number = st.one_of(st.integers(0, 3), st.integers(min_value=0))
+_versions = st.builds(
+    Version, _number, _number, _number, st.none() | _dotted, st.none() | _build
+)
+
+
+def _pad(identifier, zeros):
+    return "0" * zeros + identifier if identifier.isdigit() else identifier
+
+
+# One prerelease spelled two ways: numeric identifiers get independent leading zeros.
+_two_spellings = st.lists(
+    st.tuples(_identifier, st.integers(0, 3), st.integers(0, 3)), min_size=1, max_size=4
+).map(
+    lambda parts: (
+        ".".join(_pad(i, za) for i, za, _ in parts),
+        ".".join(_pad(i, zb) for i, _, zb in parts),
+    )
+)
+
+
+# proob:01M62GJ3S2R9DT5D7SY7S8A0BD
+@given(
+    _number,
+    _number,
+    _number,
+    st.one_of(st.tuples(st.none(), st.none()), _two_spellings, st.tuples(_dotted, _dotted)),
+    st.none() | _build,
+    st.none() | _build,
+)
+def test_equal_versions_hash_equal(major, minor, patch, prereleases, build_a, build_b):
+    pre_a, pre_b = prereleases
+    a = Version(major, minor, patch, pre_a, build_a)
+    b = Version(major, minor, patch, pre_b, build_b)
+    if a == b:
+        assert hash(a) == hash(b), f"{a!r} == {b!r} but hashes differ"
