--- a/tests/test_bump.py
+++ b/tests/test_bump.py
@@ -211,3 +211,47 @@ def test_next_version_ignores_token_for_main_parts(part, token, expected):
 def test_should_bump_build(version, expected):
     assert bump_build(version) == expected
     assert compare(version, expected) == 0
+
+
+# --- property-based checks ---
+from hypothesis import given, strategies as st  # noqa: E402
+_alnum = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-"
+_numeric_id = st.integers(min_value=0).map(str)
+_alpha_id = st.from_regex(r"[0-9]*[a-zA-Z-][0-9a-zA-Z-]*", fullmatch=True).filter(
+    str.isascii
+)
+_identifier = st.one_of(_numeric_id, _alpha_id)
+_dotted = st.lists(_identifier, min_size=1, max_size=4).map(".".join)
+_build = st.lists(st.text(_alnum, min_size=1), min_size=1, max_size=3).map(".".join)
+_number = st.one_of(st.integers(0, 3), st.integers(min_value=0))
+_versions = st.builds(
+    Version, _number, _number, _number, st.none() | _dotted, st.none() | _build
+)
+
+
+# proob:01M62GJ3NT92CB5S1099T1NBKK
+@given(_versions, st.just("") | _dotted)
+def test_next_prerelease_sorts_strictly_after(version, token):
+    result = version.next_version("prerelease", token)
+    assert result > version, f"{version!s} with token {token!r} gave {result!s}"
+
+
+# proob:01M62GJ3QZ54TRK6GP0HB0E3H9
+@given(
+    _versions,
+    st.sampled_from(["major", "minor", "patch", "prerelease", "build", "next"]),
+    st.sampled_from(Version.NAMES[:-1]),
+    st.none() | st.just("") | _dotted,
+)
+def test_bumped_versions_round_trip(version, op, part, token):
+    if op == "next":
+        result = version.next_version(part, token or "rc")
+    elif op == "prerelease":
+        result = version.bump_prerelease(token)
+    elif op == "build":
+        result = version.bump_build(token)
+    else:
+        result = getattr(version, "bump_" + op)()
+    text = str(result)
+    parsed = Version.parse(text)
+    assert parsed.to_tuple() == result.to_tuple(), f"{version!s} {op} {part} {token!r}: {text} parsed as {parsed!r}"
