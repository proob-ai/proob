+# proob:01M62H14G8CKC0V3VE3430VJ9X
+@given(_doc_edits())
+def test_key_edits_never_move_other_keys_between_tables(
+    case: tuple[dict[str, Any], list[tuple]],
+) -> None:
+    start, edits = case
+    doc = parse(tomlkit.dumps(start))
+    model = copy.deepcopy(start)
+    for edit in edits:
+        target, where = doc, model
+        for k in edit[1][:-1]:
+            target, where = target[k], where[k]
+        if edit[0] == "del":
+            del target[edit[1][-1]]
+            del where[edit[1][-1]]
+        else:
+            target[edit[1][-1]] = edit[2]
+            where[edit[1][-1]] = edit[2]
+    out = doc.as_string()
+    assert parse(out).unwrap() == model, (start, edits, out, model)
