+@st.composite
+def _toml_text(draw: st.DrawFn) -> str:
+    # Re-space a dumped document so the parser sees layout it must keep.
+    lines = tomlkit.dumps(draw(_tomls)).splitlines(keepends=True)
+    out = []
+    for line in lines:
+        if draw(st.booleans()):
+            out.append(draw(st.sampled_from(["\n", "# note\n", "  \n", "\t# x \n"])))
+        if " = " in line and draw(st.booleans()):
+            line = line.replace(" = ", draw(st.sampled_from(["=", "  =\t", " =  "])), 1)
+        if line.endswith("\n") and draw(st.booleans()):
+            line = line[:-1] + draw(st.sampled_from(["  # c\n", " \n", "\r\n"]))
+        out.append(line)
+    return "".join(out)
+
