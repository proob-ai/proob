+@st.composite
+def _array_source(draw: st.DrawFn) -> tuple[str, list[Any]]:
+    values = draw(st.lists(st.integers(min_value=-1000, max_value=1000), max_size=8))
+    sep = draw(st.sampled_from([", ", ",", ",\n    ", " , "]))
+    trailing = "," if values and draw(st.booleans()) else ""
+    multiline = draw(st.booleans())
+    body = sep.join(str(v) for v in values) + trailing
+    text = f"a = [\n    {body}\n]\n" if multiline else f"a = [{body}]\n"
+    return text, values
+
+
+_index_or_none = st.one_of(st.none(), st.integers(min_value=-12, max_value=12))
+_slices = st.builds(
+    slice,
+    _index_or_none,
+    _index_or_none,
+    st.one_of(st.none(), st.integers(min_value=-4, max_value=4).filter(bool)),
+)
+
+
+def _array_edit(n: int) -> st.SearchStrategy[tuple]:
+    edits = [
+        st.tuples(st.just("append"), _scalars),
+        st.tuples(st.just("insert"), st.integers(-n - 2, n + 2), _scalars),
+        st.tuples(st.just("add_line"), st.lists(_scalars, max_size=3)),
+        st.tuples(st.just("del_slice"), _slices),
+    ]
+    if n:
+        edits += [
+            st.tuples(st.just("set"), st.integers(-n, n - 1), _scalars),
+            st.tuples(st.just("del"), st.integers(-n, n - 1)),
+        ]
+    return st.one_of(edits)
+
+
+def _apply_edit(a: Array, model: list[Any], edit: tuple) -> None:
+    op, *args = edit
+    if op == "append":
+        a.append(args[0])
+        model.append(args[0])
+    elif op == "insert":
+        a.insert(args[0], args[1])
+        model.insert(args[0], args[1])
+    elif op == "add_line":
+        a.add_line(*args[0])
+        model.extend(args[0])
+    elif op == "set":
+        a[args[0]] = args[1]
+        model[args[0]] = args[1]
+    else:
+        del a[args[0]]
+        del model[args[0]]
+
+
+# proob:01M62H14F5F2BAFDN37JZFSM0M
+@given(_array_source(), st.data())
+def test_array_edits_round_trip_to_held_values(
+    source: tuple[str, list[Any]], data: st.DataObject
+) -> None:
+    text, values = source
+    doc = parse(text)
+    a = doc["a"]
+    model = list(values)
+    for _ in range(data.draw(st.integers(min_value=1, max_value=5))):
+        _apply_edit(a, model, data.draw(_array_edit(len(model))))
+    out = doc.as_string()
+    assert list(a) == model, (text, list(a), model)
+    assert parse(out)["a"].unwrap() == model, (text, out, model)
+
