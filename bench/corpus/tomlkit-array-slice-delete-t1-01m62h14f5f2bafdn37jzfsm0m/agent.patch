+@st.composite
+def _doc_edits(draw: st.DrawFn) -> tuple[dict[str, Any], list[tuple]]:
+    start = draw(_tomls)
+    model = copy.deepcopy(start)
+    edits = []
+    for _ in range(draw(st.integers(min_value=1, max_value=5))):
+        tables = [[]] + [[k] for k, v in model.items() if isinstance(v, dict)]
+        path = draw(st.sampled_from(tables))
+        where = model
+        for k in path:
+            where = where[k]
+        if where and draw(st.booleans()):
+            key = draw(st.sampled_from(sorted(where)))
+            edits.append(("del", path + [key]))
+            del where[key]
+        else:
+            key, value = draw(_bare_keys), draw(_values)
+            edits.append(("set", path + [key], value))
+            where[key] = value
+    return start, edits
+
