+proptest! {
+    // proob:01M62JKH5ZGJ9S1DX6N2R36VM8
+    #[test]
+    fn default_encodings_parse_back_to_the_original_text(decoded in any::<String>()) {
+        let key_default = TomlKeyBuilder::new(&decoded).as_default().to_toml_key();
+        let string_default = TomlStringBuilder::new(&decoded).as_default().to_toml_value();
+
+        let toml = format!("{key_default} = {string_default}");
+        let value = toml
+            .parse::<toml_old::Value>()
+            .unwrap_or_else(|err| panic!("text {decoded:?} encoded as {toml:?} does not parse: {err}"));
+        let table = value.as_table().unwrap();
+        prop_assert_eq!(table.len(), 1, "text {:?} encoded as {:?}", decoded, toml);
+        let (key, value) = table.iter().next().unwrap();
+        prop_assert_eq!(key, &decoded, "key: encoded as {:?}", toml);
+        prop_assert_eq!(value.as_str(), Some(decoded.as_str()), "string: encoded as {:?}", toml);
+    }
+}
