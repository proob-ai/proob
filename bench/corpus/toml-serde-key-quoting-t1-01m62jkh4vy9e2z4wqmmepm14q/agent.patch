diff --git a/crates/toml/tests/serde/ser_key.rs b/crates/toml/tests/serde/ser_key.rs
index 26a07da..4231979 100644
--- a/crates/toml/tests/serde/ser_key.rs
+++ b/crates/toml/tests/serde/ser_key.rs
@@ -556,3 +556,190 @@ k = "value"
         assert_eq!(json, input);
     }
 }
+
+mod props {
+    use super::*;
+
+    use proptest::prelude::*;
+    use serde::ser::SerializeStruct as _;
+
+    #[derive(Debug, Serialize)]
+    struct Inner {
+        value: String,
+    }
+
+    /// The three shapes a struct field takes in a document: a plain value, a table header, and an
+    /// array-of-tables header
+    #[derive(Debug, Clone, Copy)]
+    enum Shape {
+        Value,
+        Table,
+        ArrayOfTables,
+    }
+
+    /// A struct whose single field name is chosen at runtime, as `#[serde(rename)]` does
+    struct Field {
+        name: &'static str,
+        shape: Shape,
+    }
+
+    impl Serialize for Field {
+        fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+            let inner = || Inner {
+                value: "v".to_owned(),
+            };
+            let mut st = s.serialize_struct("Field", 1)?;
+            match self.shape {
+                Shape::Value => st.serialize_field(self.name, "v")?,
+                Shape::Table => st.serialize_field(self.name, &inner())?,
+                Shape::ArrayOfTables => st.serialize_field(self.name, &[inner()])?,
+            }
+            st.end()
+        }
+    }
+
+    fn shape() -> impl Strategy<Value = Shape> {
+        prop_oneof![
+            Just(Shape::Value),
+            Just(Shape::Table),
+            Just(Shape::ArrayOfTables)
+        ]
+    }
+
+    proptest! {
+        // proob:01M62JKH4VY9E2Z4WQMMEPM14Q
+        #[test]
+        fn written_keys_read_back_as_the_same_key(name in any::<String>(), shape in shape(), map in any::<bool>()) {
+            let toml = if map {
+                let mut m = BTreeMap::new();
+                m.insert(name.clone(), Field { name: "x", shape }.to_value());
+                crate::to_string(&m)
+            } else {
+                let field = Field { name: String::leak(name.clone()), shape };
+                crate::to_string(&field)
+            };
+            let toml = toml.unwrap_or_else(|e| panic!("name {name:?} shape {shape:?}: serialize failed: {e}"));
+            let table = crate::from_str::<crate::SerdeTable>(&toml)
+                .unwrap_or_else(|e| panic!("name {name:?} shape {shape:?}: output does not parse:\n{toml}\n{e}"));
+            let keys = table.keys().collect::<Vec<_>>();
+            prop_assert_eq!(keys, vec![&name], "shape {:?} output:\n{}", shape, toml);
+        }
+    }
+
+    impl Field {
+        fn to_value(&self) -> crate::SerdeValue {
+            match self.shape {
+                Shape::Value => crate::SerdeValue::String("v".to_owned()),
+                Shape::Table => {
+                    let mut t = crate::SerdeTable::new();
+                    t.insert("value".to_owned(), "v".into());
+                    crate::SerdeValue::Table(t)
+                }
+                Shape::ArrayOfTables => {
+                    let mut t = crate::SerdeTable::new();
+                    t.insert("value".to_owned(), "v".into());
+                    crate::SerdeValue::Array(vec![crate::SerdeValue::Table(t)])
+                }
+            }
+        }
+    }
+
+    #[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+    enum Unit {
+        Alpha,
+        #[serde(rename = "with space.and.dots")]
+        Beta,
+        #[serde(rename = "")]
+        Empty,
+    }
+
+    #[track_caller]
+    fn roundtrip<K>(key: K) -> Result<(), TestCaseError>
+    where
+        K: Ord + Clone + fmt::Debug + Serialize + serde::de::DeserializeOwned,
+    {
+        let input = Document {
+            map: Map::from([(key.clone(), "v".to_owned())]),
+        };
+        let toml = crate::to_string(&input)
+            .unwrap_or_else(|e| panic!("key {key:?}: serialize failed: {e}"));
+        let output = crate::from_str::<Document<K>>(&toml)
+            .unwrap_or_else(|e| panic!("key {key:?}: does not read back:\n{toml}\n{e}"));
+        prop_assert_eq!(output, input, "key {:?} output:\n{}", key, toml);
+        Ok(())
+    }
+
+    #[track_caller]
+    fn rejected<K: Serialize + fmt::Debug>(key: K) -> Result<(), TestCaseError> {
+        let input = BTreeMap::from([("map", BTreeMap::from([(OrdKey(key), "v")]))]);
+        let result = crate::to_string(&input);
+        prop_assert!(result.is_err(), "key {:?} was written: {:?}", input, result);
+        Ok(())
+    }
+
+    /// Lets keys without `Ord` (floats) sit in a one-entry map
+    #[derive(Debug, Serialize)]
+    #[serde(transparent)]
+    struct OrdKey<K>(K);
+    impl<K> PartialEq for OrdKey<K> {
+        fn eq(&self, _: &Self) -> bool {
+            true
+        }
+    }
+    impl<K> Eq for OrdKey<K> {}
+    impl<K> PartialOrd for OrdKey<K> {
+        fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
+            Some(self.cmp(other))
+        }
+    }
+    impl<K> Ord for OrdKey<K> {
+        fn cmp(&self, _: &Self) -> std::cmp::Ordering {
+            std::cmp::Ordering::Equal
+        }
+    }
+
+    proptest! {
+        // proob:01M62JKH88WHMN5BF1CSC9XPX4
+        #[test]
+        fn non_string_map_keys_round_trip_or_are_rejected(
+            b in any::<bool>(),
+            i8_ in any::<i8>(),
+            i64_ in any::<i64>(),
+            u64_ in any::<u64>(),
+            c in any::<char>(),
+            unit in prop_oneof![Just(Unit::Alpha), Just(Unit::Beta), Just(Unit::Empty)],
+            f in any::<f64>(),
+            bytes in any::<Vec<u8>>(),
+            pair in any::<(i32, i32)>(),
+        ) {
+            roundtrip(b)?;
+            roundtrip(i8_)?;
+            roundtrip(i64_)?;
+            roundtrip(u64_)?;
+            roundtrip(c)?;
+            roundtrip(unit)?;
+            rejected(f)?;
+            rejected(serde_bytes_like(bytes))?;
+            rejected(Option::<i32>::None)?;
+            rejected(pair)?;
+        }
+    }
+
+    /// Serializes through `serialize_bytes`, as `serde_bytes` does
+    struct Bytes(Vec<u8>);
+    impl fmt::Debug for Bytes {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            write!(f, "bytes{:?}", self.0)
+        }
+    }
+    impl Serialize for Bytes {
+        fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+            s.serialize_bytes(&self.0)
+        }
+    }
+    fn serde_bytes_like(v: Vec<u8>) -> Bytes {
+        Bytes(v)
+    }
+
+    use std::fmt;
+}
