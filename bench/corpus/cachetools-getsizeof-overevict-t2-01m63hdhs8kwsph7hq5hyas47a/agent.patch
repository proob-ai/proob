+"""Property-based tests for condition-guarded decorators (bound to proob properties)."""
+
+import threading
+import time
+
+from hypothesis import given, strategies as st
+
+import cachetools
+import cachetools.keys
+
+TIMEOUT = 5
+
+
+# proob:01M63HDHWKE47X6N8A7P702Y7P
+@given(
+    st.lists(
+        st.tuples(st.integers(min_value=0, max_value=2), st.booleans()),
+        min_size=1,
+        max_size=8,
+    ),
+    st.integers(min_value=1, max_value=3),
+)
+def test_condition_releases_keys_and_computes_each_once_at_a_time(calls, maxsize):
+    guard = threading.Lock()
+    running = {}
+    overlaps = []
+
+    # the cache key is k alone, so calls on one k must never overlap, whatever fail is
+    @cachetools.cached(
+        cachetools.LRUCache(maxsize),
+        key=lambda k, fail: cachetools.keys.hashkey(k),
+        condition=threading.Condition(),
+    )
+    def compute(k, fail):
+        with guard:
+            running[k] = running.get(k, 0) + 1
+            if running[k] > 1:
+                overlaps.append(k)
+        try:
+            time.sleep(0.001)
+            if fail:
+                raise RuntimeError(k)
+            return k
+        finally:
+            with guard:
+                running[k] -= 1
+
+    def call(k, fail):
+        try:
+            compute(k, fail)
+        except RuntimeError:
+            pass
+
+    threads = [threading.Thread(target=call, args=c, daemon=True) for c in calls]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(TIMEOUT)
+    stuck = [c for t, c in zip(threads, calls) if t.is_alive()]
+    assert not stuck, (calls, maxsize, "callers still waiting", stuck)
+    assert not overlaps, (calls, maxsize, "keys computed concurrently", overlaps)
+
+    # every key must be released afterwards: a fresh call on each finishes
+    for k in {k for k, _ in calls}:
+        t = threading.Thread(target=call, args=(k, False), daemon=True)
+        t.start()
+        t.join(TIMEOUT)
+        assert not t.is_alive(), (calls, maxsize, "key left pending", k)
