@@ -236,3 +236,22 @@ def test_without():
     assert lwithout([]) == []
     assert lwithout([1, 2, 3, 4]) == [1, 2, 3, 4]
     assert lwithout([1, 2, 1, 0, 3, 1, 4], 0, 1) == [2, 3, 4]
+
+
+# Property-based checks
+from hypothesis import given, strategies as st
+
+# proob:01M63JAA2BYH8BTG6NR72M0X82
+@given(st.lists(st.integers()), st.integers(1, 6), st.one_of(st.none(), st.integers(1, 8)))
+def test_partition_chunks_part_sizes(xs, n, step):
+    args = (n,) if step is None else (n, step)
+    parts = lpartition(*args, xs)
+    assert all(len(p) == n for p in parts), (xs, n, step, parts)
+    assert parts == lpartition(*args, iter(xs)), (xs, n, step, parts)
+    chunked = lchunks(*args, xs)
+    assert chunked == lchunks(*args, iter(xs)), (xs, n, step, chunked)
+    assert all(len(p) == n for p in chunked[:-1]) and all(len(p) <= n for p in chunked), \
+        (xs, n, step, chunked)
+    if step is None:
+        assert [x for p in chunked for x in p] == xs, (xs, n, chunked)
+        assert [x for p in parts for x in p] == xs[:len(xs) // n * n], (xs, n, parts)
