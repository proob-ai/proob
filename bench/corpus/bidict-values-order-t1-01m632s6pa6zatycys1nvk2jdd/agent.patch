+@given(
+    bi_t=mut_bidict_t,
+    init=items121,
+    updates=items,
+    od=sampled_from((None, *on_dups)),
+    bad=sampled_from((None, *range(len(BAD_ITEMS)))),  # by index: BAD_ITEMS holds an object whose hash raises
+    via_inv=booleans(),
+)
+def test_failed_bulk_update_leaves_bidict_unchanged(
+    bi_t: MBT[int, int], init: Items121, updates: Items, od: OnDup | None, bad: int | None, via_inv: bool
+) -> None:
+    bi = bi_t(init).inv if via_inv else bi_t(init)
+    before, before_inv = bi.copy(), bi.inv.copy()
+    upd = list(updates) if bad is None else [*updates, BAD_ITEMS[bad][1]]
+    try:
+        if od is None:
+            bi.update(upd)
+        else:
+            bi.putall(upd, od)
+    except Exception:  # noqa: BLE001  # any failure at all must leave bi as it was
+        assert bi.equals_order_sensitive(before), f'{init=} {upd=} {od=}: {list(bi.items())} != {list(before.items())}'
+        assert bi.inv.equals_order_sensitive(before_inv), f'{init=} {upd=} {od=}: inverse {list(bi.inv.items())}'
+
