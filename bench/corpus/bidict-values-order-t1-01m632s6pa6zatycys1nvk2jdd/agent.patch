+@given(bi_t=mut_bidict_t, init=items121, ops=puts)
+def test_inverse_mirrors_forward_pairs(bi_t: MBT[int, int], init: Items121, ops: t.Any) -> None:
+    bi = bi_t(init)
+    for op in ops:
+        apply_puts(bi, [op])
+        fwd = {(k, bi[k]) for k in bi}
+        inv = {(k, v) for (v, k) in ((v, bi.inv[v]) for v in bi.inv)}
+        assert fwd == inv, f'after {op}: forward {sorted(fwd)} vs flipped inverse {sorted(inv)}'
+        assert len(bi) == len(bi.inv), f'after {op}: {dict(bi)} vs {dict(bi.inv)}'
