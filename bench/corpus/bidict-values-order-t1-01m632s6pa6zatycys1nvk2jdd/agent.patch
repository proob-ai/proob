+# proob:01M632S6M4FHPEP9YW6PMFWTA3
+@given(bi_t=mut_bidict_t, init=items121, ops=puts)
+def test_no_two_keys_share_a_value(bi_t: MBT[int, int], init: Items121, ops: t.Any) -> None:
+    bi = bi_t(init)
+    for op in ops:
+        apply_puts(bi, [op])
+        fwd_vals = [bi[k] for k in bi]
+        assert len(set(fwd_vals)) == len(fwd_vals), f'after {op}: {dict(bi)}'
+        assert len(bi.inv) == len(bi), f'{dict(bi)} vs inverse {dict(bi.inv)}'
+
