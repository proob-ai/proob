+def apply_puts(bi: MutableBidict[int, int], ops: t.Sequence[tuple[int, int, OnDup, bool]]) -> None:
+    for key, val, od, via_inv in ops:
+        try:
+            if via_inv:
+                bi.inv.put(val, key, od)
+            else:
+                bi.put(key, val, od)
+        except DuplicationError:
+            pass
+
+
+def init_or_dedup(bi_t: BT[int, int], items: Items) -> BB[int, int]:
+    try:
+        return bi_t(items)
+    except DuplicationError:  # this type's on_dup rejects these items; settle for a 1:1 init
+        return bi_t(dedup(items))
+
