+@given(bi_t=bidict_t, init=items, ops=puts)
+def test_values_follow_items_order(bi_t: BT[int, int], init: Items, ops: t.Any) -> None:
+    bi = init_or_dedup(bi_t, init)
+    if isinstance(bi, MutableBidict):
+        apply_puts(bi, ops)
+    assert list(bi.values()) == [v for (_, v) in bi.items()], f'{bi_t.__name__}({init}) then {ops}: {list(bi.items())=}'
+    assert list(bi.values()) == [bi[k] for k in bi], f'{bi_t.__name__}({init}) then {ops}: {list(bi.values())=}'
