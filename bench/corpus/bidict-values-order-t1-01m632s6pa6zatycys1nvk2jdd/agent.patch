+# proob:01M632S6QDS3TEAB71S9936V16
+@given(bi_t=ordered_bidict_t, init=items, ops=lists(tuples(keys, vals, on_dup)))
+def test_ordered_views_follow_insertion_order(bi_t: BT[int, int], init: Items, ops: t.Any) -> None:
+    oracle = Oracle[int, int]({}, ordered=True)
+    try:
+        oracle.putall(init, bi_t.on_dup)
+        bi = bi_t(init)
+    except DuplicationError:
+        oracle = Oracle(dedup(init), ordered=True)
+        bi = bi_t(dedup(init))
+    if isinstance(bi, MutableBidict):
+        for key, val, od in ops:
+            assert_calls_match(partial(bi.put, key, val, od), partial(oracle.put, key, val, od))
+    expect = list(oracle.data.items())
+    ctx = f'{bi_t.__name__}({init}) then {ops}'
+    assert list(bi) == [k for (k, _) in expect], f'{ctx}: {list(bi)=}'
+    assert list(bi.keys()) == [k for (k, _) in expect], f'{ctx}: {list(bi.keys())=}'
+    assert list(bi.values()) == [v for (_, v) in expect], f'{ctx}: {list(bi.values())=}'
+    assert list(bi.items()) == expect, f'{ctx}: {list(bi.items())=}'
+    assert repr(bi) == f'{bi_t.__name__}({dict(expect)!r})' if expect else repr(bi) == f'{bi_t.__name__}()', repr(bi)
+    assert list(reversed(bi)) == [k for (k, _) in expect][::-1], f'{ctx}: {list(reversed(bi))=}'
+    assert list(reversed(bi.items())) == expect[::-1], f'{ctx}: {list(reversed(bi.items()))=}'
+    assert list(reversed(bi.values())) == [v for (_, v) in expect][::-1], f'{ctx}: {list(reversed(bi.values()))=}'
+
