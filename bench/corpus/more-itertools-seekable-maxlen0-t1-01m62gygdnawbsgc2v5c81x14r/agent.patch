+# proob:01M62GYGDNAWBSGC2V5C81X14R
+@given(
+    st.lists(st.integers()),
+    st.none() | st.integers(min_value=0, max_value=10),
+    st.lists(st.sampled_from(['next', 'peek', 'bool'])),
+)
+def test_lookahead_never_drops_item(items, maxlen, ops):
+    s = mi.seekable(items, maxlen=maxlen)
+    end = object()
+    pos = 0
+    for op in ops:
+        if op == 'next':
+            actual = next(s, end)
+            expected = items[pos] if pos < len(items) else end
+            pos += pos < len(items)
+        elif op == 'peek':
+            actual = s.peek(end)
+            expected = items[pos] if pos < len(items) else end
+        else:
+            actual, expected = bool(s), pos < len(items)
+        assert actual == expected, (items, maxlen, ops, op, pos, actual)
+    rest = list(s)
+    assert rest == items[pos:], (items, maxlen, ops, rest)
+
