+def test_rewind_replays_in_order(items, k, extra):
+    s = mi.seekable(items)
+    mi.take(k, s)
+    s.seek(0)
+    replayed = mi.take(k + extra, s)
+    expected = items[: k + extra]
+    assert replayed == expected, (items, k, extra, replayed)
