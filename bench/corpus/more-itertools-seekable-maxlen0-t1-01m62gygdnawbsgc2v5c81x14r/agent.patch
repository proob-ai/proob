+def test_bounded_cache_keeps_latest(items, maxlen, k):
+    s = mi.seekable(items, maxlen=maxlen)
+    consumed = mi.take(k, s)
+    expected = consumed[max(len(consumed) - maxlen, 0) :] if maxlen else []
+    cached = list(s.elements())
+    assert cached == expected, (items, maxlen, k, cached)
