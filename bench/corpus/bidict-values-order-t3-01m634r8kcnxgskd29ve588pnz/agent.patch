+# proob:01M634R8N27Y6W0HS37CW6N6ER
+@given(bi_t=ordered_mut_bidict_t, puts=lists(tuples(items, on_dup), max_size=6))
+def test_ordered_views_follow_insertion_order(bi_t: type[OrderedBidict[int, int]], puts: list[t.Any]) -> None:
+    bi = bi_t()
+    oracle: Oracle[int, int] = Oracle({}, ordered=True)
+    for new_items, od in puts:
+        for target in (bi, oracle):
+            try:
+                target.putall(new_items, od)
+            except DuplicationError:
+                pass
+    expect = list(oracle.data.items())
+    msg = f'{puts=} expect={expect} items={list(bi.items())}'
+    assert list(bi) == list(bi.keys()) == [k for (k, _) in expect], msg
+    assert list(bi.values()) == [v for (_, v) in expect], msg
+    assert list(bi.items()) == expect, msg
+    assert list(reversed(bi)) == list(reversed(bi.keys())) == [k for (k, _) in expect][::-1], msg
+    assert list(reversed(bi.items())) == expect[::-1], msg
+    assert list(reversed(bi.values())) == [v for (_, v) in expect][::-1], msg
