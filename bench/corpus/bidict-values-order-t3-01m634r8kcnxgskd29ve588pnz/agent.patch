+# A random sequence of mutations, reaching the bidict through both itself and its inverse.
+mutations = lists(tuples(sampled_from(('putall', 'inv_putall', 'forceupdate', 'pop', 'popitem')), items, on_dup), max_size=8)
+ordered_mut_bidict_t = sampled_from([bt for bt in mutable_bidict_types if issubclass(bt, OrderedBidictBase)])
+
+
+def apply_mutation(bi: MutableBidict[int, int], mutation: tuple[str, Items, OnDup]) -> None:
+    name, new_items, od = mutation
+    try:
+        match name:
+            case 'putall':
+                bi.putall(new_items, od)
+            case 'inv_putall':
+                bi.inv.putall(new_items, od)
+            case 'forceupdate':
+                bi.forceupdate(new_items)
+            case 'pop' if new_items:
+                bi.pop(new_items[0][0], None)
+            case 'popitem' if bi:
+                bi.popitem()
+    except DuplicationError:
+        pass
+
+
+# proob:01M634R8EEBEVH1YN4K8Q5NJCA
+@given(bi_t=mut_bidict_t, init=items121, muts=mutations)
+def test_bidict_and_inverse_mirror_after_mutations(bi_t: MBT[int, int], init: Items121, muts: list[t.Any]) -> None:
+    bi = bi_t(init)
+    for mut in muts:
+        apply_mutation(bi, mut)
+        fwd = {k: bi[k] for k in bi}
+        inv = {v: bi.inv[v] for v in bi.inv}
+        assert inv == {v: k for (k, v) in fwd.items()}, f'{init=} {muts=} {fwd=} {inv=}'
+        assert len(bi) == len(bi.inv) == len(fwd), f'{init=} {muts=} {len(bi)=} {len(bi.inv)=}'
+        assert bi.inv.inv is bi
+
+
+# proob:01M634R8FWSFFSE1ASZNXH5CZ0
+@given(bi_t=mut_bidict_t, init=items121, muts=mutations)
+def test_values_stay_unique_after_mutations(bi_t: MBT[int, int], init: Items121, muts: list[t.Any]) -> None:
+    bi = bi_t(init)
+    for mut in muts:
+        apply_mutation(bi, mut)
+        seen = [bi[k] for k in bi]
+        assert len(set(seen)) == len(seen), f'{init=} {muts=} values={seen}'
+
+
+# proob:01M634R8HR8HXZ0FY7V413YJJ2
+@given(
+    bi_t=mut_bidict_t,
+    init=items121,
+    new_items=items,
+    od=sampled_from((None, *on_dups)),
+    bad=sampled_from((None, *range(len(BAD_ITEMS)))),  # an index: BAD_ITEMS' bomb cannot be hashed
+)
+def test_rejected_bulk_update_fails_clean(
+    bi_t: MBT[t.Any, t.Any], init: Items121, new_items: Items, od: OnDup | None, bad: int | None
+) -> None:
+    bi = bi_t(init)
+    before = bi.copy()
+    updates = list(new_items) if bad is None else [*new_items, BAD_ITEMS[bad][1]]
+    try:
+        bi.update(updates) if od is None else bi.putall(updates, od)
+    except (DuplicationError, RuntimeError, TypeError, ValueError):
+        msg = f'{init=} {updates=} {od=} before={list(before.items())} after={list(bi.items())}'
+        if isinstance(bi, OrderedBidictBase):
+            assert bi.equals_order_sensitive(before), msg
+            assert bi.inv.equals_order_sensitive(before.inv), msg
+        else:
+            assert bi == before, msg
+            assert bi.inv == before.inv, msg
+
