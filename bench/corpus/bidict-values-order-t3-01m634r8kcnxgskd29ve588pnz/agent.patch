+# proob:01M634R8KCNXGSKD29VE588PNZ
+@given(bi_t=bidict_t, init=items, overwrites=items)
+def test_values_iterate_in_item_order(bi_t: BT[int, int], init: Items, overwrites: Items) -> None:
+    try:
+        bi = bi_t(init)
+    except DuplicationError:
+        bi = bi_t(dedup(init))
+    if isinstance(bi, MutableBidict):
+        bi.forceupdate(overwrites)
+    expect = [v for (_, v) in bi.items()]
+    assert list(bi.values()) == expect, f'{bi_t=} {init=} {overwrites=} values={list(bi.values())} items={list(bi.items())}'
+
