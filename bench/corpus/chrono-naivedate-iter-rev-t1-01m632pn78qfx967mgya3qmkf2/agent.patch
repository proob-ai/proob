diff --git a/src/naive/date/tests.rs b/src/naive/date/tests.rs
index 0b47ca4..0baf5f3 100644
--- a/src/naive/date/tests.rs
+++ b/src/naive/date/tests.rs
@@ -918,3 +918,107 @@ const MIN_DAYS_FROM_YEAR_0: i32 = MIN_YEAR * 365 + MIN_YEAR / 4 - MIN_YEAR / 100
 
 // only used for testing, but duplicated in naive::datetime
 const MAX_BITS: usize = 44;
+
+mod props {
+    use super::{Days, NaiveDate};
+    use proptest::prelude::*;
+
+    /// Any representable date, over the whole range from `NaiveDate::MIN` to `NaiveDate::MAX`.
+    fn any_date() -> impl Strategy<Value = NaiveDate> {
+        let (lo, hi) = (NaiveDate::MIN.num_days_from_ce(), NaiveDate::MAX.num_days_from_ce());
+        (lo..=hi).prop_map(|n| NaiveDate::from_num_days_from_ce_opt(n).unwrap())
+    }
+
+    /// Dates the iterators start from: anywhere, or within a few weeks of either end.
+    fn start_date() -> impl Strategy<Value = NaiveDate> {
+        prop_oneof![
+            any_date(),
+            (0u64..64).prop_map(|k| NaiveDate::MIN + Days::new(k)),
+            (0u64..64).prop_map(|k| NaiveDate::MAX - Days::new(k)),
+        ]
+    }
+
+    /// The forward items of a run of `step`-day dates starting at `d`: `d + step * i` while
+    /// `d + step * (i + 1)` is still representable. Returns the `k`-th item counted from the back.
+    fn kth_from_back(d: NaiveDate, step: i64, k: i64) -> Option<NaiveDate> {
+        let n = NaiveDate::MAX.signed_duration_since(d).num_days() / step;
+        let i = n - 1 - k;
+        (i >= 0).then(|| d + Days::new((step * i) as u64))
+    }
+
+    proptest! {
+        // proob:01M632PN78QFX967MGYA3QMKF2
+        #[test]
+        fn days_read_from_back_are_forward_days_reversed(d in start_date(), k in 0i64..16) {
+            let got = d.iter_days().rev().nth(k as usize);
+            prop_assert_eq!(got, kth_from_back(d, 1, k), "start {:?}, item {} from the back", d, k);
+        }
+
+        // proob:01M632PNFNM0MYXEYDWSDCWGA0
+        #[test]
+        fn weeks_read_from_back_are_forward_weeks_reversed(d in start_date(), k in 0i64..16) {
+            let got = d.iter_weeks().rev().nth(k as usize);
+            prop_assert_eq!(got, kth_from_back(d, 7, k), "start {:?}, item {} from the back", d, k);
+        }
+
+        // proob:01M632PN9KDMT5JB2V894X9HE9
+        #[test]
+        fn printed_date_parses_back_to_itself(d in start_date()) {
+            let shown = d.to_string();
+            prop_assert_eq!(shown.parse::<NaiveDate>().ok(), Some(d), "Display text {:?}", shown);
+            let debug = format!("{:?}", d);
+            prop_assert_eq!(debug.parse::<NaiveDate>().ok(), Some(d), "Debug text {:?}", debug);
+        }
+
+        // proob:01M632PNBM2NJNQZQ343PVEBZ7
+        #[test]
+        fn reported_length_counts_dates_yielded(
+            d in start_date(),
+            weeks in any::<bool>(),
+            from_back in proptest::collection::vec(any::<bool>(), 0..32),
+        ) {
+            let mut it: Box<dyn DoubleEndedIterator<Item = NaiveDate>> = if weeks {
+                Box::new(d.iter_weeks())
+            } else {
+                Box::new(d.iter_days())
+            };
+            let len = |it: &dyn DoubleEndedIterator<Item = NaiveDate>| it.size_hint();
+            for (step, &back) in from_back.iter().enumerate() {
+                let before = len(&*it);
+                prop_assert_eq!(before.1, Some(before.0), "start {:?}, step {}: not exact", d, step);
+                let item = if back { it.next_back() } else { it.next() };
+                let after = len(&*it).0;
+                match item {
+                    Some(x) => prop_assert_eq!(after + 1, before.0,
+                        "start {:?}, weeks {}, step {} (back {}): yielded {:?} but length went {} -> {}",
+                        d, weeks, step, back, x, before.0, after),
+                    None => prop_assert_eq!((before.0, after), (0, 0),
+                        "start {:?}, weeks {}, step {} (back {}): ended with length {}",
+                        d, weeks, step, back, before.0),
+                }
+            }
+        }
+
+        // proob:01M632PNDCJN65JDTNHQ7GAPDB
+        #[test]
+        fn mixed_reads_never_repeat_a_date(
+            d in start_date(),
+            weeks in any::<bool>(),
+            from_back in proptest::collection::vec(any::<bool>(), 0..32),
+        ) {
+            let mut it: Box<dyn DoubleEndedIterator<Item = NaiveDate>> = if weeks {
+                Box::new(d.iter_weeks())
+            } else {
+                Box::new(d.iter_days())
+            };
+            let mut seen = std::collections::HashSet::new();
+            for (step, &back) in from_back.iter().enumerate() {
+                if let Some(x) = if back { it.next_back() } else { it.next() } {
+                    prop_assert!(seen.insert(x),
+                        "start {:?}, weeks {}, reads {:?}: {:?} returned again at step {}",
+                        d, weeks, &from_back[..=step], x, step);
+                }
+            }
+        }
+    }
+}
