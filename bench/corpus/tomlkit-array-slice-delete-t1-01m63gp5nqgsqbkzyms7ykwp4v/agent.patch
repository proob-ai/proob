+    step = st.none() | st.integers(-4, 4).filter(lambda s: s != 0)
+    key: int | slice = draw(
+        st.builds(slice, bound, bound, step)
+        | (st.integers(-len(values), len(values) - 1) if values else st.nothing())
+    )
+    return text, values, key
+
