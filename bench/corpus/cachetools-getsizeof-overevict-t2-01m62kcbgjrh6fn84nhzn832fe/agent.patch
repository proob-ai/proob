         cache.timer.tick()
         cache.timer.tick()  # past TTL
         self.assertNotIn(42, cache)
+
+
+from hypothesis import given, strategies as st  # noqa: E402
+
+
+# proob:01M62KCBKTSE89TGX7GG387T7M
+@given(
+    st.integers(1, 10),
+    st.dictionaries(st.integers(0, 5), st.integers(1, 10), min_size=1),
+    st.data(),
+)
+def test_expired_overwrite_drops_old_value(maxsize, live, data):
+    # ttu returns time + value: a value of 0 or less is already expired.
+    timer = Timer()
+    cache = TLRUCache(maxsize, ttu=lambda _k, v, t: t + v, timer=timer)
+    for k, v in live.items():
+        cache[k] = v
+    key = data.draw(st.sampled_from(sorted(cache)))
+    cache[key] = data.draw(st.integers(-5, 0))
+    assert key not in cache, (live, key, dict(cache))
+    assert cache.get(key) is None, (live, key, dict(cache))
+    assert key not in set(cache), (live, key, dict(cache))
+    assert cache.currsize == len(cache), (live, key, cache.currsize, len(cache))
