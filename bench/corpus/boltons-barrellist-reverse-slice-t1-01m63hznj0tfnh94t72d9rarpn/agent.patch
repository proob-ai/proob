+# proob:01M63HZNN9YBQZ5WQRDEKMQQ2E
+@given(st.sampled_from([OMD, FastIterOrderedMultiDict]),
+       st.lists(st.tuples(st.sampled_from(['add', 'set', 'pop', 'popall']),
+                          st.sampled_from('abcde'), st.integers()), max_size=40))
+def test_omd_reversed_matches_forward(omd_type, ops):
+    omd = omd_type()
+    for op, k, v in ops:
+        if op == 'add':
+            omd.add(k, v)
+        elif op == 'set':
+            omd[k] = v
+        elif op == 'pop':
+            omd.pop(k, None)
+        else:
+            omd.popall(k, None)
+    forward, backward = list(omd), list(reversed(omd))
+    assert backward == forward[::-1], (omd_type, ops, forward, backward)
diff --git a/tests/test_listutils.py b/tests/test_listutils.py
index d7f0749..4507991 100644
--- a/tests/test_listutils.py
+++ b/tests/test_listutils.py
@@ -204,3 +204,50 @@ def test_barrel_list_matches_list():
             assert ref[i] == bl[i]
         assert len(ref) == len(bl)
     assert list(bl) == ref
+
+
+from hypothesis import given, strategies as st
+
+
+def _bl(items, size_factor):
+    # a small size factor forces many sublists, so slices cross sublist boundaries
+    bl = BarrelList()
+    bl._size_factor = size_factor
+    bl.extend(items)
+    for i in range(len(bl.lists)):
+        bl._balance_list(i)
+    return bl
+
+
+_bounds = st.one_of(st.none(), st.integers(min_value=-60, max_value=60))
+
+
+# proob:01M63HZNJ0TFNH94T72D9RARPN
+@given(st.lists(st.integers(), max_size=50), st.sampled_from([1, 2, 1520]),
+       _bounds, _bounds, st.integers(min_value=-5, max_value=-1))
+def test_barrel_list_reverse_slice_matches_list(items, size_factor, start, stop, step):
+    bl = _bl(items, size_factor)
+    got = list(bl[start:stop:step])
+    want = items[start:stop:step]
+    assert got == want, (items, start, stop, step, got)
+
+
+# proob:01M63HZNK3TZKD40HTABBRT2H8
+@given(st.lists(st.integers(), max_size=40), st.sampled_from([1, 2, 1520]),
+       st.lists(st.tuples(st.sampled_from(['insert', 'pop', 'pop_last', 'get']),
+                          st.integers(min_value=-50, max_value=50),
+                          st.integers()), max_size=60))
+def test_barrel_list_ops_match_list(items, size_factor, ops):
+    ref, bl = list(items), _bl(items, size_factor)
+    for op, i, v in ops:
+        if op == 'insert':
+            ref.insert(i, v)
+            bl.insert(i, v)
+        elif op == 'pop_last' and ref:
+            assert bl.pop() == ref.pop(), (items, ops)
+        elif op in ('pop', 'get') and -len(ref) <= i < len(ref):
+            got = bl.pop(i) if op == 'pop' else bl[i]
+            want = ref.pop(i) if op == 'pop' else ref[i]
+            assert got == want, (items, ops, op, i, got, want)
+        assert len(bl) == len(ref), (items, ops)
+    assert list(bl) == ref, (items, ops, list(bl), ref)
diff --git a/tests/test_setutils.py b/tests/test_setutils.py
index cfed65f..f618363 100644
--- a/tests/test_setutils.py
+++ b/tests/test_setutils.py
@@ -331,3 +331,29 @@ def test_small_difference_update_unchanged():
     thing = IndexedSet(range(100))
     thing.difference_update({1, 3, 5})
     assert list(thing)[:5] == [0, 2, 4, 6, 7]
+
+
+from hypothesis import given, strategies as st
+
+
+# proob:01M63HZNPDG9W4T447H3KSYPJJ
+@given(st.lists(st.integers(min_value=-20, max_value=20), max_size=40),
+       st.lists(st.tuples(st.sampled_from(['remove', 'pop', 'pop_last']),
+                          st.integers(min_value=-25, max_value=25)), max_size=30))
+def test_indexed_set_after_removals_matches_fresh(items, ops):
+    iset = IndexedSet(items)
+    for op, x in ops:
+        if op == 'remove':
+            iset.discard(x)
+        elif op == 'pop' and -len(iset) <= x < len(iset):
+            iset.pop(x)
+        elif op == 'pop_last' and iset:
+            iset.pop()
+    fresh = IndexedSet(list(iset))
+    assert list(iset) == list(fresh), (items, ops)
+    assert list(reversed(iset)) == list(reversed(fresh)), (items, ops)
+    for i in range(-len(fresh), len(fresh)):
+        assert iset[i] == fresh[i], (items, ops, i, iset[i], fresh[i])
+    for v in fresh:
+        assert iset.index(v) == fresh.index(v), (items, ops, v)
+    assert list(iset[1::2]) == list(fresh[1::2]), (items, ops)
