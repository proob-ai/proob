     assert sorted(tc.keys()) == [2, 5]
     assert sorted(tc.values()) == [1, 10]
     assert sorted(tc.items()) == [(2, 10), (5, 1)]
+
+
+from hypothesis import given, strategies as st
+
+
+# proob:01M63HZNM6YYQ6EJ44PK45V0B9
+@given(st.sampled_from([LRI, LRU]), st.integers(min_value=1, max_value=8),
+       st.lists(st.tuples(st.sampled_from(['set', 'get', 'del', 'setdefault', 'update', 'pop']),
+                          st.integers(min_value=0, max_value=15)), max_size=80))
+def test_cache_never_exceeds_max_size(cache_type, max_size, ops):
+    cache = cache_type(max_size=max_size)
+    for op, k in ops:
+        if op == 'set':
+            cache[k] = k
+        elif op == 'get':
+            cache.get(k)
+        elif op == 'del':
+            cache.pop(k, None)
+        elif op == 'setdefault':
+            cache.setdefault(k, k)
+        elif op == 'update':
+            cache.update({k: k, k + 1: k, k + 2: k})
+        else:
+            cache.pop(k, None)
+        assert len(cache) <= max_size, (cache_type, max_size, ops, len(cache))
+        assert len(list(cache.keys())) <= max_size, (cache_type, max_size, ops)
