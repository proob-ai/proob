+# This file is dual licensed under the terms of the Apache License, Version
+# 2.0, and the BSD License. See the LICENSE file in the root of this repository
+# for complete details.
+
+from __future__ import annotations
+
+import itertools
+
+from hypothesis import given
+
+from packaging.version import Version
+from tests.property.strategies import pep440_versions
+
+# Not marked `property`: proob runs bound tests by node id under the default addopts.
+
+
+# proob:01M63HBEFMB4512908ZTMRQ7C1
+@given(a=pep440_versions(), b=pep440_versions(), c=pep440_versions())
+def test_version_order_is_total_and_consistent(
+    a: Version, b: Version, c: Version
+) -> None:
+    for x, y in itertools.permutations([a, b, c], 2):
+        outcomes = [x < y, x == y, x > y]
+        assert outcomes.count(True) == 1, f"{x} vs {y}: <,==,> gave {outcomes}"
+        assert (x <= y) == (x < y or x == y), f"{x} <= {y} disagrees with < or =="
+        if x == y:
+            assert hash(x) == hash(y), f"{x} == {y} but hashes differ"
+    for x, y, z in itertools.permutations([a, b, c]):
+        if x <= y and y <= z:
+            assert x <= z, f"{x} <= {y} <= {z} but not {x} <= {z}"
