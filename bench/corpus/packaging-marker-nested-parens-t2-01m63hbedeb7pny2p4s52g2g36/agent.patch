@@ -0,0 +1,41 @@
+# This file is dual licensed under the terms of the Apache License, Version
+# 2.0, and the BSD License. See the LICENSE file in the root of this repository
+# for complete details.
+
+from __future__ import annotations
+
+from hypothesis import given
+from hypothesis import strategies as st
+
+from packaging.requirements import Requirement
+from tests.property.strategies import pep440_specifier_strings
+from tests.property.test_markers import marker_texts
+
+# Not marked `property`: proob runs bound tests by node id under the default addopts.
+_names = st.from_regex(r"[A-Za-z0-9]([A-Za-z0-9._-]{0,6}[A-Za-z0-9])?", fullmatch=True)
+
+
+@st.composite
+def requirement_texts(draw: st.DrawFn) -> str:
+    text = draw(_names)
+    extras = draw(st.lists(_names, max_size=3))
+    if extras:
+        text += "[" + ",".join(extras) + "]"
+    if draw(st.booleans()):
+        text += " @ " + draw(st.sampled_from(
+            ["https://example.com/pkg.whl", "file:///tmp/pkg.tar.gz"]
+        )) + " "
+    elif draw(st.booleans()):
+        text += draw(pep440_specifier_strings())
+    if draw(st.booleans()):
+        text += "; " + draw(marker_texts)
+    return text
+
+
+# proob:01M63HBEEHTGYVNZ7YHV6H4XD5
+@given(text=requirement_texts())
+def test_requirement_text_round_trip(text: str) -> None:
+    req = Requirement(text)
+    printed = str(req)
+    again = Requirement(printed)
+    assert again == req, f"{text!r} printed as {printed!r} reads back as {str(again)!r}"
