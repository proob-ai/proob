index 0000000..cb5ceb3
--- /dev/null
+++ b/tests/property/test_markers.py
@@ -0,0 +1,85 @@
+# This file is dual licensed under the terms of the Apache License, Version
+# 2.0, and the BSD License. See the LICENSE file in the root of this repository
+# for complete details.
+
+from __future__ import annotations
+
+from hypothesis import given
+from hypothesis import strategies as st
+
+from packaging.markers import Marker
+from packaging.utils import canonicalize_name
+
+# Not marked `property`: proob runs bound tests by node id under the default addopts.
+_NAMES = ["os_name", "sys_platform", "implementation_name"]
+_VALUES = ["a", "b", "c"]
+
+_atoms = st.builds(
+    lambda name, op, value: f'{name} {op} "{value}"',
+    st.sampled_from(_NAMES),
+    st.sampled_from(["==", "!="]),
+    st.sampled_from(_VALUES),
+)
+
+
+def _bracket(text: str, depth: int) -> str:
+    return "(" * depth + text + ")" * depth
+
+
+@st.composite
+def _group(draw: st.DrawFn, children: st.SearchStrategy[str]) -> str:
+    parts = draw(st.lists(children, min_size=1, max_size=3))
+    text = parts[0]
+    for part in parts[1:]:
+        text += f" {draw(st.sampled_from(['and', 'or']))} {part}"
+    return _bracket(text, draw(st.integers(min_value=0, max_value=3)))
+
+
+# Marker texts with "and"/"or" chains and 0-3 levels of brackets per group.
+marker_texts = st.recursive(_atoms, _group, max_leaves=8)
+environments = st.fixed_dictionaries({n: st.sampled_from(_VALUES) for n in _NAMES})
+
+
+# proob:01M63HBEDEB7PNY2P4S52G2G36
+@given(text=marker_texts, env=environments)
+def test_marker_text_round_trip_keeps_meaning(text: str, env: dict[str, str]) -> None:
+    marker = Marker(text)
+    printed = str(marker)
+    assert Marker(printed).evaluate(env) == marker.evaluate(env), (
+        f"{text!r} printed as {printed!r} decides differently in {env!r}"
+    )
+
+
+_extra_names = st.from_regex(r"[A-Za-z0-9]([A-Za-z0-9._-]{0,6}[A-Za-z0-9])?", fullmatch=True)
+
+
+# proob:01M63HBEGQJVBM985YKTHV1TF7
+@given(written=_extra_names, requested=_extra_names, flip=st.booleans())
+def test_extra_names_match_after_normalisation(
+    written: str, requested: str, flip: bool
+) -> None:
+    text = f'"{written}" == extra' if flip else f'extra == "{written}"'
+    matches = Marker(text).evaluate({"extra": requested})
+    expected = canonicalize_name(written) == canonicalize_name(requested)
+    assert matches == expected, (
+        f"{text!r} with extra={requested!r} gave {matches}, expected {expected}"
+    )
+
+
+# proob:01M63HBEHTG6M0QQAQY65GEJRV
+@given(
+    left=marker_texts,
+    right=marker_texts,
+    join=st.sampled_from(["and", "or"]),
+    env=environments,
+)
+def test_combining_markers_matches_joined_text(
+    left: str, right: str, join: str, env: dict[str, str]
+) -> None:
+    a, b = Marker(left), Marker(right)
+    combined = a & b if join == "and" else a | b
+    joined = Marker(f"({left}) {join} ({right})")
+    assert combined.evaluate(env) == joined.evaluate(env), (
+        f"{left!r} {join} {right!r}: combined {combined.evaluate(env)}, "
+        f"joined {joined.evaluate(env)} in {env!r}"
+    )
