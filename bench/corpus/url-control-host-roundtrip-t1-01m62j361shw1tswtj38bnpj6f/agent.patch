@@ -0,0 +1,19 @@
+use percent_encoding::{percent_decode_str, percent_encode, AsciiSet, CONTROLS, NON_ALPHANUMERIC};
+use proptest::prelude::*;
+
+// Decoding inverts encoding only for sets that escape `%` itself.
+const SETS: [&AsciiSet; 3] = [
+    NON_ALPHANUMERIC,
+    &CONTROLS.add(b'%'),
+    &CONTROLS.add(b'%').add(b' ').add(b'\x22').add(b'#').add(b'<').add(b'>'),
+];
+
+proptest! {
+    // proob:01M62J363YZ0WJHN986MRZ2NMT
+    #[test]
+    fn percent_encoding_round_trips(bytes in any::<Vec<u8>>(), set in 0..SETS.len()) {
+        let encoded = percent_encode(&bytes, SETS[set]).to_string();
+        let decoded: Vec<u8> = percent_decode_str(&encoded).collect();
+        prop_assert_eq!(&decoded, &bytes, "set #{} encoded {:?}", set, encoded);
+    }
+}
