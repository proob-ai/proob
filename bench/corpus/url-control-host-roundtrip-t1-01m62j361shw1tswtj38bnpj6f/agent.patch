+use idna::punycode::{decode_to_string, encode_str};
+use proptest::prelude::*;
+
+fn label() -> impl Strategy<Value = String> {
+    prop_oneof![
+        any::<String>(),
+        prop::collection::vec(
+            prop_oneof![
+                prop::char::range('a', 'z'),
+                prop::char::range('A', 'Z'),
+                Just('-'),
+                prop::char::range('\u{80}', '\u{3ff}'),
+                prop::char::range('\u{4e00}', '\u{4e40}'),
+                prop::char::range('\u{1f600}', '\u{1f640}'),
+            ],
+            0..30
+        )
+        .prop_map(|v| v.into_iter().collect()),
+    ]
+}
+
+proptest! {
+    // proob:01M62J362WD0ZH2EJ6VQN07DW7
+    #[test]
+    fn punycode_round_trips(input in label()) {
+        if let Some(encoded) = encode_str(&input) {
+            let decoded = decode_to_string(&encoded);
+            prop_assert_eq!(decoded.as_deref(), Some(input.as_str()), "label {:?} encoded to {:?}", input, encoded);
+        }
+    }
+}
